adbd: listen on 127.0.0.1:5554 as well as on USB, never on the network by itself

nocry: adb over the network is something the owner turns on (nocry-remote puts a relay in
front of this port, on 5555); adbd of this vintage has no authentication, so it must not
listen on every interface, and it cannot be told at run time where to listen (no property
service here).
---
--- a/core/adbd/adb.c
+++ b/core/adbd/adb.c
@@ -1324,11 +1324,10 @@
         // listen on TCP port specified by service.adb.tcp.port property
     //    local_init(port);
     //} else 
-    if (!usb) {
-        printf("Using USB\n");
-        // listen on default port
-        local_init(DEFAULT_ADB_LOCAL_TRANSPORT_PORT);
-    }
+    // nocry: always, beside USB, but on this machine only (see transport_local.c):
+    // a relay on the board opens it to the network (port 5555) when the owner turns that on
+    (void)usb;
+    local_init(5554);
 
     D("adb_main(): pre init_jdwp()\n");
     init_jdwp();
--- a/core/adbd/transport_local.c
+++ b/core/adbd/transport_local.c
@@ -162,7 +162,7 @@
     serverfd = -1;
     for(;;) {
         if(serverfd == -1) {
-            serverfd = socket_inaddr_any_server(port, SOCK_STREAM);
+            serverfd = socket_loopback_server(port, SOCK_STREAM);	/* nocry: not on the network by itself */
             if(serverfd < 0) {
                 D("server: cannot bind socket yet\n");
                 adb_sleep_ms(1000);
