# nocry recovery initramfs (Buildroot 2025.02.x).
# XBurst2 = MIPS32r5 with a NaN-2008-only FPU (the stock userland is NaN-2008 too, ld-linux-mipsn8):
# hard-float o32, FPXX, NaN-2008, so the kernel needs no ieee754=relaxed.
BR2_mipsel=y
BR2_mips_32r5=y
# BR2_MIPS_SOFT_FLOAT is not set
BR2_MIPS_FP32_MODE_XX=y
BR2_MIPS_ENABLE_NAN_2008=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_6=y
BR2_TARGET_GENERIC_HOSTNAME="nocry-recovery"
BR2_TARGET_GENERIC_ISSUE="nocry recovery (RAM only)"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY_PORT="console"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(NOCRY_RECOVERY)/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(NOCRY_RECOVERY)/post-build.sh"
# nocry's own patches to packages (adbd: see br-patches/android-tools)
BR2_GLOBAL_PATCH_DIR="$(NOCRY_RECOVERY)/br-patches"
BR2_PACKAGE_ANDROID_TOOLS=y
BR2_PACKAGE_ANDROID_TOOLS_ADBD=y
# BR2_PACKAGE_ANDROID_TOOLS_FASTBOOT is not set
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_SQUASHFS=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_NONE=y
# BR2_TARGET_ROOTFS_TAR is not set
