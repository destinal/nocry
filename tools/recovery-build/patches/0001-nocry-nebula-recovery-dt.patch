diff --git a/module_drivers/dts/x2000/nocry_nebula.dts b/module_drivers/dts/x2000/nocry_nebula.dts
new file mode 100644
index 000000000..571f91aa1
--- /dev/null
+++ b/module_drivers/dts/x2000/nocry_nebula.dts
@@ -0,0 +1,84 @@
+/dts-v1/;
+/*
+ * nocry recovery: minimal device tree for Creality "Nebula" X2000E boards
+ * (retail Nebula Pad, Ender-3 V3 KE / CR-10 SE / Ender-5 Max pads).
+ * Pins and eMMC settings come from the stock Nebula 4.4 kernel's built-in DTB.
+ * Only what recovery needs: UART2 console, eMMC (MSC0, 8-bit), USB device mode.
+ * The eFuse block and the watchdog are disabled on purpose.
+ */
+#include "x2000.dtsi"
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <generated/autoconf.h>
+
+/ {
+	model = "nocry recovery (Creality Nebula, Ingenic X2000E)";
+	compatible = "ingenic,nocry-nebula", "ingenic,x2000";
+
+	aliases {
+		serial2 = &uart2;
+	};
+
+	chosen {
+		/*
+		 * The burner U-Boot passes no mem=; extra args from `fastboot boot --cmdline` are appended.
+		 * 0x0e800000-0x0e8fffff: nocrymem log ring (outside mem=), read by `fastboot oem dmesg`.
+		 * panic=0: hang instead of rebooting (a reboot would boot the stock firmware over the log).
+		 * The XBurst2 FPU is NaN-2008 only: the userland must be built NaN-2008 (it is, see
+		 * buildroot.defconfig); a legacy-NaN userland would need ieee754=relaxed here.
+		 */
+		bootargs = "console=ttyS2,115200n8 mem=232M@0x0 earlycon=nocrymem keep_bootcon ignore_loglevel panic=0 rdinit=/init";
+	};
+
+	refclk: refclk@0 {
+		#clock-cells = <0>;
+		compatible = "fixed-clock";
+		clock-frequency = <24000000>;
+	};
+};
+
+&uart0 { status = "disabled"; };
+&uart2 {
+	compatible = "ingenic,x1000-uart";
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2_pd>;
+	clocks = <&refclk>, <&clock CLK_GATE_UART2>;
+	clock-names = "baud", "module";
+};
+
+&pdma { status = "okay"; };
+
+&msc0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&msc0_8bit>;
+	mmc-hs200-1_8v;
+	cap-mmc-highspeed;
+	non-removable;
+	max-frequency = <100000000>;
+	bus-width = <8>;
+	voltage-ranges = <1800 3300>;
+};
+
+&otg {
+	status = "okay";
+	dr_mode = "peripheral";
+};
+&otg_phy { status = "okay"; };
+
+/*
+ * No watchdog: if recovery fails it must stay in RAM (hung), not reset into the stock
+ * firmware, which overwrites all of DDR including the nocrymem log.
+ */
+&watchdog { status = "disabled"; };
+
+/* not needed for recovery */
+&efuse { status = "disabled"; };
+&i2c3 { status = "disabled"; };
+&i2c4 { status = "disabled"; };
+&icodec { status = "disabled"; };
+&rotate { status = "disabled"; };
+&felix { status = "disabled"; };
+&helix { status = "disabled"; };
+&mscaler0 { status = "disabled"; };
+&mscaler1 { status = "disabled"; };
diff --git a/module_drivers/dts/x2000/nocry_nebula_rescue.dts b/module_drivers/dts/x2000/nocry_nebula_rescue.dts
new file mode 100644
index 000000000..0427ed883
--- /dev/null
+++ b/module_drivers/dts/x2000/nocry_nebula_rescue.dts
@@ -0,0 +1,145 @@
+/*
+ * nocry-rescue: the nocry recovery device tree for Creality "Nebula" boards plus what a
+ * touchscreen recovery needs: display, backlight, touch bus, Wi-Fi.
+ * Pins are those the stock Nebula firmware passes to its drivers (module_driver/*.sh):
+ *   panel       480x272 RGB565 on PB0-15/PB24-27, power PC21 (active low), reset PB16
+ *   backlight   PWM0 on PC0, supply PC22
+ *   touch       NS2009 (resistive) on I2C4, PC25/PC26, read from user space through i2c-dev
+ *   Wi-Fi       BCM43438 (AP6212A) on MSC1 (SDIO, 4 bit), power PA1 (low = on), enable PD4
+ *               (low = off), wake-up line PE2, 32 kHz clock from PE23
+ */
+#include "nocry_nebula.dts"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = "nocry-rescue (Creality Nebula, Ingenic X2000E)";
+
+	/*
+	 * As nocry_nebula.dts, plus brcmfmac.feature_disable: the Wi-Fi chip's firmware offers to
+	 * do the WPA handshake itself (FWSUP, 0x2000; SAE, 0x80000), and with this chip's firmware
+	 * joining a network then fails ("association rejected, status 16", then a deauthentication).
+	 * With both turned off wpa_supplicant does the handshake, which works.
+	 */
+	chosen {
+		bootargs = "console=ttyS2,115200n8 mem=232M@0x0 earlycon=nocrymem keep_bootcon ignore_loglevel panic=0 rdinit=/init brcmfmac.feature_disable=0x82000";
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* frame buffers of the display controller */
+		reserved_memory: reserved_mem@d000000 {
+			compatible = "shared-dma-pool";
+			no-map;
+			reg = <0x0d000000 0x01000000>;
+		};
+	};
+
+	display-dbi {
+		compatible = "simple-bus";
+		#interrupt-cells = <1>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <>;
+
+		panel_nebula {
+			compatible = "nocry,nebula-lcd";
+			status = "okay";
+			pinctrl-names = "default";
+			pinctrl-0 = <&tft_lcd_pb_rgb565>;
+			ingenic,vdd-en-gpios = <&gpc 21 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
+			ingenic,rst-gpios = <&gpb 16 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
+
+			port {
+				panel_nebula_ep: endpoint {
+					remote-endpoint = <&dpu_out_ep>;
+				};
+			};
+		};
+	};
+
+	backlight {
+		compatible = "pwm-backlight";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pwm0_pc>;
+		pwms = <&pwm 0 20000>;		/* channel 0, 50 kHz as the stock firmware */
+		brightness-levels = <0 30 60 100 150 200 255>;
+		default-brightness-level = <5>;
+		enable-gpios = <&gpc 22 GPIO_ACTIVE_HIGH INGENIC_GPIO_NOBIAS>;
+	};
+
+	wifi_power: wifi-power {
+		compatible = "regulator-fixed";
+		regulator-name = "wifi_power";
+		gpio = <&gpa 1 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;	/* low = powered */
+		enable-active-low;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&gpd 4 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
+		post-power-on-delay-ms = <200>;
+		power-off-delay-ms = <5>;
+	};
+};
+
+&pwm { status = "okay"; };
+
+&dpu {
+	status = "okay";
+	ingenic,disable-rdma-fb = <1>;
+	ingenic,layer-exported  = <1 0 0 0>;
+	ingenic,layer-frames    = <2 2 2 2>;
+	ingenic,layer-framesize = <480 272>, <480 272>, <480 272>, <480 272>;
+	layer,color_mode        = <0 0 0 0>;
+	layer,src-size          = <480 272>, <480 272>, <480 272>, <480 272>;
+	layer,target-size       = <480 272>, <480 272>, <480 272>, <480 272>;
+	layer,target-pos        = <0 0>, <0 0>, <0 0>, <0 0>;
+	layer,enable            = <1 0 0 0>;
+	ingenic,logo-pan-layer  = <0>;
+	memory-region = <&reserved_memory>;
+	port {
+		dpu_out_ep: endpoint {
+			remote-endpoint = <&panel_nebula_ep>;
+		};
+	};
+};
+
+&i2c4 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c4_pc>;
+	clock-frequency = <400000>;
+};
+
+&msc1 {
+	status = "okay";
+	pinctrl-names = "default", "enable", "disable";
+	/* the chip needs the SoC's 32 kHz clock (PE23) before it answers at all */
+	pinctrl-0 = <&msc1_4bit &rtc32k_enable>;
+	pinctrl-1 = <&rtc32k_enable>;
+	pinctrl-2 = <&rtc32k_disable>;
+
+	bus-width = <4>;
+	non-removable;
+	keep-power-in-suspend;
+	max-frequency = <50000000>;
+	voltage-ranges = <1800 3300>;
+	mmc-pwrseq = <&wifi_pwrseq>;
+
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	wifi@1 {
+		reg = <1>;
+		compatible = "brcm,bcm43430a1";
+		interrupt-parent = <&gpe>;
+		interrupts = <2 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "host-wake";
+		brcm,board-type = "AP6212";
+	};
+};
