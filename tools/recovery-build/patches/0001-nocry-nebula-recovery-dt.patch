diff --git a/drivers/tty/serial/earlycon-nocrymem.c b/drivers/tty/serial/earlycon-nocrymem.c
new file mode 100644
index 000000000..0841d3963
--- /dev/null
+++ b/drivers/tty/serial/earlycon-nocrymem.c
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * nocry memory console: "earlycon=nocrymem[,<phys>]" (default 0x0e800000).
+ * Every kernel message goes through the uncached KSEG1 window into a 1 MiB ring,
+ * so it is already in DDR when the board is reset (boards without a UART).
+ * The nocry fastboot stage2 prints it with `fastboot oem dmesg`.
+ * Layout: u32 magic "CMEM", u32 total bytes written, u32 ring size, u32 0, ring.
+ * Keep it out of the kernel's memory: mem= must end at or below <phys>.
+ */
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/serial_core.h>
+#include <asm/addrspace.h>
+
+#define MEMCON_DEFAULT	0x0e800000
+#define MEMCON_SIZE	(1 << 20)
+#define MEMCON_MAGIC	0x4d454d43	/* "CMEM" */
+
+static volatile u32 *memcon_hdr;
+static volatile char *memcon_ring;
+static u32 memcon_cap;
+
+static void memcon_write(struct console *con, const char *s, unsigned int n)
+{
+	u32 pos = memcon_hdr[1];
+
+	while (n--)
+		memcon_ring[pos++ % memcon_cap] = *s++;
+	memcon_hdr[1] = pos;
+}
+
+static int __init memcon_setup(struct earlycon_device *dev, const char *opt)
+{
+	phys_addr_t base = MEMCON_DEFAULT;
+
+	if (dev->port.mapbase)
+		base = dev->port.mapbase;
+	else if (opt && *opt)
+		base = simple_strtoul(opt, NULL, 0);
+	memcon_hdr = (volatile u32 *)CKSEG1ADDR(base);
+	memcon_ring = (volatile char *)(memcon_hdr + 4);
+	memcon_cap = MEMCON_SIZE - 16;
+	memcon_hdr[0] = MEMCON_MAGIC;
+	memcon_hdr[1] = 0;
+	memcon_hdr[2] = memcon_cap;
+	memcon_hdr[3] = 0;
+	dev->con->write = memcon_write;
+	return 0;
+}
+EARLYCON_DECLARE(nocrymem, memcon_setup);
