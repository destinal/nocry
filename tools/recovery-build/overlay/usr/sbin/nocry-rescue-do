#!/bin/sh
# nocry-rescue-do: what the rescue system's web pages can do to the board, in one place
# (docs/nocry-rescue.md). Everything that touches the storage goes through nocry-fbd's own
# commands (nocry-fbd --exec), so reading, comparing and verified writing are not done twice.
#
#   nocry-rescue-do status          the board and its two firmware slots, as key=value lines
#   nocry-rescue-do switch a|b      make that slot the one that starts
#   nocry-rescue-do copy a|b        copy that slot's firmware over the other slot       (a job)
#   nocry-rescue-do reset mods|all  blank the settings overlay, or it and all files     (a job)
#   nocry-rescue-do check data|settings   check and repair that file system (e2fsck)      (a job)
#   nocry-rescue-do health          the storage chip's own wear report, the data partition's state
#   nocry-rescue-do ls DIR          a folder of the data partition: "d|f<TAB>size<TAB>name" lines
#   nocry-rescue-do get FILE        a file of the data partition, to standard output
#   nocry-rescue-do put FILE        standard input into a file of the data partition
#   nocry-rescue-do rm FILE         delete a file (or an empty folder) of the data partition
#   nocry-rescue-do bundle logs|config|identity   a download, to standard output (tar.gz; identity: the raw record)
#   nocry-rescue-do wifi-save       write the Wi-Fi network the board is on into the installed firmware's settings
#   nocry-rescue-do restart         leave the rescue system: restart the board normally
#   nocry-rescue-do fw-list [refresh]   firmware that can be installed here: key, name, version, date, bytes, file (tabs)
#   nocry-rescue-do fw-fetch KEY VERSION SLOT|KEEP   download it and work out what installing would do   (a job)
#   nocry-rescue-do fw-upload-path  where the page stores an uploaded firmware file (starts an install session)
#   nocry-rescue-do fw-check NAME SLOT|KEEP        the same for an uploaded file                         (a job)
#   nocry-rescue-do fw-report       what the check found (key=value lines), or nothing
#   nocry-rescue-do fw-install      install what was checked                                              (a job)
#   nocry-rescue-do fw-discard      forget it and remove the downloaded file
#   nocry-rescue-do loader [install|factory]   the boot loader: say what is there, or change it
#   nocry-rescue-do logo [nocry|firmware]      the boot logo: say what is there, or change it
#   nocry-rescue-do rescue-status   is the rescue system stored on the board, and will the loader find it?
#   nocry-rescue-do rescue-install  standard input (a rescue image) -> a copy behind each slot's system image
#   nocry-rescue-do rescue-remove   take the copies away again
#   nocry-rescue-do update-check [again]   newer rescue image or nocryboot loader in this project's releases on GitHub?
#   nocry-rescue-do update-rescue   download the newest rescue image, check it, store both copies          (a job)
#   nocry-rescue-do update-loader   download the newest nocryboot for this board, check it, install it    (a job)
#   nocry-rescue-do rescue-heal     one copy good, the other not: make the other from it (run at every start of rescue)
#   nocry-rescue-do cal-get | cal-put   the touch calibration, kept beside the copies (cal-put: standard input)
#   nocry-rescue-do usb-status      the USB flash drive: mounted=yes|no, fs=, label=, size=, free=, readonly=
#   nocry-rescue-do usb-eject       write everything out and unmount it
#   nocry-rescue-do usb-format exfat|fat32         erase the flash drive: one partition with that file system
#   nocry-rescue-do usb-targets     what can be backed up: "full<TAB>bytes", then "<partition><TAB>bytes" lines
#   nocry-rescue-do usb-backup full|PARTITION      the whole storage or one partition -> an image on the drive  (a job)
#   nocry-rescue-do usb-list backups|fw            images / firmware files found on the drive (tab-separated)
#   nocry-rescue-do usb-info FILE   what restoring that image would do (key=value lines)
#   nocry-rescue-do usb-restore FILE               write that image back, verified                               (a job)
#   nocry-rescue-do fw-check-usb FILE SLOT|KEEP    work out what installing a firmware file on the drive would do (a job)
#   nocry-rescue-do job             the running or last job: state=, what=, done=, total=, message=
#   nocry-rescue-do cancel          ask the running job to stop at its next safe point
#
# A job runs on its own (it outlives the page that started it), one at a time, and records its
# progress in /run/nocry-job. Stopping one leaves what its `risk=` line says.

DISK=${NOCRY_DISK:-/dev/mmcblk0}
FBD=${NOCRY_FBD:-/usr/sbin/nocry-fbd}
RUN=${NOCRY_RUN:-/run}
SYS=${NOCRY_SYS:-/sys}; DEV=${NOCRY_DEV:-/dev}       # elsewhere only in tests
JOB=$RUN/nocry-job
LOCK=$RUN/nocry-job.lock
STOP=$RUN/nocry-job.stop
STEP=1000000        # 16 MiB per command (hex), so progress and Cancel are never far away

fb() { "$FBD" --exec "$1" "$DISK" 2>/dev/null; }                 # prints "OKAY ..." / "FAIL ..."
ok() { r=$(fb "$1"); case "$r" in OKAY*) echo "${r#OKAY }"; return 0 ;; *) echo "${r#FAIL }"; return 1 ;; esac; }

part() {    # device node of the partition named $1 (a real board), or nothing (a test image)
    for u in $SYS/class/block/mmcblk0p*/uevent; do
        grep -q "^PARTNAME=$1\$" "$u" 2>/dev/null && { echo "$DEV/$(basename "$(dirname "$u")")"; return 0; }
    done
    return 1
}
size() { s=$(ok "getvar:partition-size:$1") || return 1; printf '%d' "$s"; }    # bytes
sfx() { [ "$1" = b ] && echo 2; }

# first bytes of a partition as hex: head NAME OFFSET COUNT
head_hex() { p=$(part "$1") || return 1; dd if="$p" bs=1 skip="$2" count="$3" 2>/dev/null | hexdump -v -e '/1 "%02x"'; }

# What a slot holds. Prints: complete=yes|no, firmware=<name and version, or what is missing>
slot() {
    x=$(sfx "$1"); miss=
    [ "$(head_hex "rtos$x" 8 4)" = 52544f53 ] || miss="$miss start program,"
    [ "$(head_hex "kernel$x" 0 4)" = 27051956 ] || miss="$miss kernel,"
    [ "$(head_hex "rootfs$x" 0 4)" = 68737173 ] || miss="$miss system,"
    if [ -n "$miss" ]; then
        echo "$1_complete=no"; echo "$1_firmware=incomplete (no${miss%,})"; return
    fi
    echo "$1_complete=yes"
    name="unrecognised firmware"
    m=$RUN/nocry-slot; mkdir -p $m
    if p=$(part "rootfs$x") && mount -t squashfs -o ro "$p" $m 2>/dev/null; then
        if [ -f $m/etc/ota_info ]; then
            b=$(sed -n 's/^ota_board_name=//p' $m/etc/ota_info | tr -d '\r'); v=$(sed -n 's/^ota_version=//p' $m/etc/ota_info | tr -d '\r')
            case "$b" in
                NEBULA) b="Retail Nebula Pad" ;; F005) b="Ender-3 V3 KE" ;; F003) b="CR-10 SE" ;; F004) b="Ender-5 Max" ;;
                CR4CU220812S1?) b="K1 series" ;; F001) b="Ender-3 V3 series" ;;
            esac
            name="Creality $b $v"
        elif grep -q '^ID=nebulaos' $m/usr/lib/os-release 2>/dev/null; then
            name="NebulaOS $(sed -n 's/^VERSION_ID=//p' $m/usr/lib/os-release | tr -d '"\r')"
        fi
        umount $m 2>/dev/null
    fi
    echo "$1_firmware=$name"
}

status() {
    a=$(ok getvar:current-slot) || a=
    echo "active=$a"
    slot a; slot b
    # the identity record: model and mainboard only; serial number and MAC stay off the page
    if p=$(part sn_mac); then
        rec=$(dd if="$p" bs=512 count=1 2>/dev/null | tr -d '\000')
        echo "model=$(echo "$rec" | cut -d';' -f3)"; echo "mainboard=$(echo "$rec" | cut -d';' -f4)"
    fi
    # what the nocryboot loader noted about the last starts (second sector of ota)
    if p=$(part ota); then echo "note=$(dd if="$p" bs=512 skip=1 count=1 2>/dev/null | tr -d '\000' | head -1 | tr -cd 'a-zA-Z0-9:=_-')"; fi
}

job_state() {   # job_state STATE WHAT DONE TOTAL MESSAGE
    printf 'state=%s\nwhat=%s\ndone=%s\ntotal=%s\nmessage=%s\nrisk=%s\n' "$1" "$2" "$3" "$4" "$5" "$RISK" > $JOB.new && { [ -z "$NOSTOP" ] || echo "stoppable=no" >> $JOB.new; mv $JOB.new $JOB; }
}

# run_job NAME FUNCTION ARGS...: takes the lock, runs in the background on its own
run_job() {
    mkdir $LOCK 2>/dev/null || { echo "another job is still running" >&2; exit 1; }
    rm -f $STOP
    what=$1; shift
    job_state running "$what" 0 1 ""
    (
        trap 'rmdir $LOCK 2>/dev/null' EXIT
        if "$@"; then job_state done "$what" "$DONE" "$TOTAL" "$MSG"
        elif [ -e $STOP ]; then job_state cancelled "$what" "$DONE" "$TOTAL" "$MSG"
        else job_state failed "$what" "$DONE" "$TOTAL" "$MSG"; fi
        rm -f $STOP
    ) </dev/null >/dev/null 2>&1 &
}

# one fbd command per 16 MiB over a partition: over NAME SIZE COMMAND-PREFIX (offset and size are appended)
DONE=0; TOTAL=1; MSG=; RISK=; IDLE=; NOSTOP=
over() {
    off=0
    while [ $off -lt "$2" ]; do
        [ -e $STOP ] && { MSG="cancelled before completion"; return 1; }
        n=$(( $2 - off )); [ $n -gt $((0x$STEP)) ] && n=$((0x$STEP))
        r=$(ok "$3:$(printf '%x' $off):$(printf '%x' $n)") || { MSG="$1: $r"; return 1; }
        off=$((off + n)); DONE=$((DONE + n))
        job_state running "$what" "$DONE" "$TOTAL" "$1"
    done
}

do_copy() {     # do_copy FROM(a|b)
    f=$(sfx "$1"); if [ "$1" = a ]; then t=2; else t=; fi
    TOTAL=0
    # the last 50 MiB of a root file system partition are not firmware: each slot keeps its
    # own copy of the rescue system there (see rescue_install)
    for p in rtos kernel rootfs; do
        s=$(size "$p$f") && d=$(size "$p$t") || { MSG="cannot read the size of $p"; return 1; }
        [ "$s" = "$d" ] || { MSG="$p$f and $p$t differ in size; the slot cannot be copied"; return 1; }
        [ $p = rootfs ] && s=$((s - 52428800))
        TOTAL=$((TOTAL + s))
    done
    for p in rtos kernel rootfs; do
        s=$(size "$p$f"); [ $p = rootfs ] && s=$((s - 52428800))
        over "$p$t" "$s" "nocry-pcopy:$p$f:$p$t" || return 1
    done
    MSG="copied and verified"
}

do_reset() {    # do_reset mods|all
    parts="rootfs_data"; [ "$1" = all ] && parts="rootfs_data userdata"
    TOTAL=0; for p in $parts; do s=$(size "$p") || { MSG="no $p partition"; return 1; }; TOTAL=$((TOTAL + s)); done
    for p in $parts; do over "$p" "$(size "$p")" "nocry-zero:$p" || return 1; done
    MSG="erased and verified"
}

# --- the data partition (userdata, "/usr/data" in the firmware), mounted only while it is used
DATA=$RUN/nocry-files
SESSION=$RUN/nocry-install        # exists while a firmware file is held for installing: data stays mounted
data_on() {     # data_on ro|rw
    if [ -d $SESSION ]; then grep -q " $DATA " /proc/mounts && return 0; fi
    [ -d $LOCK ] && { echo "another job is still running" >&2; return 1; }
    p=$(part userdata) || { echo "no userdata partition" >&2; return 1; }
    mkdir -p $DATA
    grep -q " $DATA " /proc/mounts && umount $DATA 2>/dev/null
    if [ "$1" = rw ]; then mount -t ext4 -o rw "$p" $DATA 2>/dev/null
    else mount -t ext4 -o ro,noload "$p" $DATA 2>/dev/null; fi || {
        echo "userdata has no readable file system (blank after a reset, or damaged: run fsck)" >&2; return 1; }
}
data_off() { sync; [ -d $SESSION ] && return 0; umount $DATA 2>/dev/null; }
# a path inside the data partition; nothing that climbs out of it
inside() {
    case "/$1/" in */../*|*/./*) echo "bad path" >&2; return 1 ;; esac
    P=$DATA/${1#/}
}

do_check() {    # do_check PARTITION: e2fsck, repairing; the report is kept for the page
    p=$(part "$1") || { MSG="no $1 partition"; return 1; }
    TOTAL=1; DONE=0
    if [ "$(dd if="$p" bs=1 skip=1080 count=2 2>/dev/null | hexdump -v -e '/1 "%02x"')" != 53ef ]; then
        MSG="no file system (blank: the firmware creates one at next boot)"; DONE=1; return 0
    fi
    e2fsck -fy "$p" > $RUN/nocry-check.log 2>&1; rc=$?
    DONE=1
    case $rc in
        0) MSG="no errors found" ;;
        1|2|3) MSG="errors found and repaired" ;;
        *) MSG="unrepairable errors remain (e2fsck exit $rc); a factory reset recreates the file system"; return 1 ;;
    esac
}

health() {
    d=/sys/block/mmcblk0/device
    echo "chip=$(cat $d/name 2>/dev/null)"
    # JEDEC: life time estimates A and B in steps of 10 % used (0x01 = 0-10 %, 0x0b = past its life)
    lt=$(cat $d/life_time 2>/dev/null); a=${lt% *}; b=${lt#* }
    pct() { case "$1" in 0x0[1-9]|0x0a) echo $(( ($1 - 1) * 10 ))-$(( $1 * 10 )) ;; 0x0b) echo over-100 ;; *) echo unknown ;; esac; }
    echo "wear_a=$(pct "$a")"; echo "wear_b=$(pct "$b")"
    case "$(cat $d/pre_eol_info 2>/dev/null)" in 0x01) echo "spare=normal" ;; 0x02) echo "spare=80 % of the spare blocks used" ;; 0x03) echo "spare=90 % of the spare blocks used" ;; *) echo "spare=unknown" ;; esac
    if data_on ro 2>/dev/null; then
        df -k $DATA | awk 'END { printf "data_total_mb=%d\ndata_used_mb=%d\ndata_free_mb=%d\n", $2 / 1024, $3 / 1024, $4 / 1024 }'
        echo "data_state=readable"; data_off
    else echo "data_state=no file system"; fi
}

# What a download holds. Paths that exist are taken; both firmwares' layouts are known.
bundle() {
    case "$1" in
      identity) p=$(part sn_mac) || exit 1; dd if="$p" bs=512 count=1 2>/dev/null; return ;;
      backup) gzip -1 -c "$DISK"; return ;;       # the whole storage; unpack it and restore it with nocry on a computer
      logs)   want="printer_data/logs nebulaos/printer_data/logs nebulaos/system creality/userdata/log" ;;
      config) want="printer_data/config nebulaos/printer_data/config nebulaos/nebulascreen nebulascreen creality/userdata/config" ;;
      *) echo "usage: nocry-rescue-do bundle logs|config|identity" >&2; exit 2 ;;
    esac
    data_on ro || exit 1
    have=; for w in $want; do [ -e "$DATA/$w" ] && have="$have $w"; done
    T=$RUN/nocry-bundle; rm -rf $T; mkdir -p $T
    if [ "$1" = logs ]; then        # plus what the rescue system itself knows
        dmesg > $T/rescue-kernel.log 2>/dev/null
        status > $T/board-status.txt 2>/dev/null; health >> $T/board-status.txt 2>/dev/null
        cp $RUN/nocry-check.log $RUN/nocry-usb.log $T/ 2>/dev/null
        data_on ro || exit 1        # health unmounted it
    fi
    # one archive: the board's files under data/, the rescue system's own notes beside them
    if [ -n "$have" ]; then ( cd $DATA && tar cf - $have 2>/dev/null ) | ( cd $T && mkdir -p data && cd data && tar xf - 2>/dev/null ); fi
    ( cd $T && tar cf - . 2>/dev/null ) | gzip      # this tar has no compression of its own
    rm -rf $T; data_off
}

# The network the board is on, into the settings of the installed firmware, so the printer
# joins it by itself at its next normal start (a board whose screen cannot be used).
wifi_save() {
    [ -s $RUN/nocry-sta.conf ] || { echo "not connected to a network configured in rescue" >&2; exit 1; }
    data_on rw || exit 1
    if [ -d $DATA/nebulaos ]; then f=$DATA/nebulaos/network/wpa_supplicant.conf; else f=$DATA/wpa_supplicant.conf; fi
    mkdir -p "$(dirname "$f")"
    {
        # the firmware's own first lines if it has any, else what both firmwares write themselves
        if [ -f "$f" ]; then awk '/^[ \t]*network=\{/ { exit } { print }' "$f"; else printf 'ctrl_interface=/var/run/wpa_supplicant\nupdate_config=1\n'; fi
        awk '/^[ \t]*network=\{/ { on = 1 } on { print } on && /^[ \t]*\}/ { on = 0 }' $RUN/nocry-sta.conf | grep -v 'scan_ssid'
    } > "$f.new" && mv "$f.new" "$f" && chmod 600 "$f"
    rc=$?; data_off
    [ $rc = 0 ] && echo "saved for ${f#$DATA/}"
    exit $rc
}

# The board has no clock that keeps time, and a download over https checks the server's
# certificate against the date. Set it once from the network (it is only ever used for that).
clock() {
    [ "$(date +%Y)" -ge 2025 ] && return 0
    # the Date line of any web server's answer is close enough (plain http: no certificate needed yet)
    # (pages made for exactly this kind of question: they answer over plain http and carry a date)
    d=
    for u in http://example.com/ http://detectportal.firefox.com/success.txt http://neverssl.com/; do
        d=$(wget -q -S -T 6 -O /dev/null $u 2>&1 | sed -n 's/^ *[Dd]ate: *[A-Za-z]*, *//p' | head -1 | tr -d '\r')
        [ -n "$d" ] && break
    done
    set -- $d       # 27 Nov 2026 10:11:12 GMT
    case "$2" in Jan) m=01 ;; Feb) m=02 ;; Mar) m=03 ;; Apr) m=04 ;; May) m=05 ;; Jun) m=06 ;; Jul) m=07 ;; Aug) m=08 ;; Sep) m=09 ;; Oct) m=10 ;; Nov) m=11 ;; Dec) m=12 ;; *) return 1 ;; esac
    date -u -s "$3-$m-$1 $4" >/dev/null 2>&1
    [ "$(date +%Y)" -ge 2025 ]
}

# --- nocry itself on the board: the same program and checks as on a computer --------------
# It works on the board's own storage, unpacks into files instead of memory (the staging
# folder) and keeps its downloads on the data partition, which has the room.
WORKDIR=$DATA/.nocry-rescue
nocry_env() {
    export NOCRY_BOARD_DISK=$DISK NOCRY_IMAGES=/usr/share/nocry/images
    export XDG_DATA_HOME=$WORKDIR/data NOCRY_STAGE_DIR=$WORKDIR/stage HOME=$WORKDIR
}
# start an install session: the data partition mounted read-write with room to work in
session_on() {
    [ -x /usr/sbin/nocry ] || { echo "this rescue image has no installer (nocry is missing)" >&2; return 1; }
    if [ ! -d $SESSION ]; then
        p=$(part userdata) || { echo "no userdata partition" >&2; return 1; }
        mkdir -p $DATA; grep -q " $DATA " /proc/mounts && umount $DATA 2>/dev/null
        made=
        if [ "$(dd if="$p" bs=1 skip=1080 count=2 2>/dev/null | hexdump -v -e '/1 "%02x"')" != 53ef ]; then
            # blank (after a reset): a file system of our own to work in, removed again afterwards
            # so the firmware finds the partition blank and makes its own
            mke2fs -F -q -t ext4 "$p" >/dev/null 2>&1 || { echo "userdata is blank and mke2fs failed" >&2; return 1; }
            made=1
        fi
        mount -t ext4 -o rw "$p" $DATA 2>/dev/null || { echo "userdata cannot be mounted (damaged? run fsck)" >&2; return 1; }
        mkdir -p $SESSION; [ -n "$made" ] && : > $SESSION/made-fs
    fi
    rm -rf $WORKDIR/stage; mkdir -p $WORKDIR/stage $WORKDIR/data
    nocry_env
}
session_off() {
    rm -rf $WORKDIR
    sync; grep -q " $DATA " /proc/mounts && umount $DATA 2>/dev/null
    if [ -e $SESSION/made-fs ]; then ok "nocry-zero:userdata:0:100000" >/dev/null; fi      # back to blank
    rm -rf $SESSION
}

# Runs nocry with the job's progress taken from what it prints; stops it politely on Cancel.
# nocry_job LOGFILE ARGS...
nocry_job() {
    log=$1; shift
    /usr/sbin/nocry "$@" > "$log" 2>&1 &
    np=$!
    while kill -0 $np 2>/dev/null; do
        [ -e $STOP ] && kill -TERM $np 2>/dev/null
        last=$(tr '\r' '\n' < "$log" | tail -1 | sed 's/^ *//; s/ *$//')
        [ -n "$last" ] || last=$IDLE        # nothing said yet: what this phase starts with
        # "<what>:  12/110 MiB ..." or "... 12.0 MB of 110.0 MB"
        set -- $(echo "$last" | sed -n 's/.* \([0-9][0-9]*\)\/\([0-9][0-9]*\) MiB.*/\1 \2/p')
        if [ -n "$2" ]; then DONE=$(( $1 << 20 )); TOTAL=$(( $2 << 20 )); fi
        job_state running "$what" "$DONE" "$TOTAL" "$(echo "$last" | cut -c1-90)"
        sleep 1
    done
    wait $np
}
last_line() { tr '\r' '\n' < "$1" | grep -v '^ *$' | tail -1 | sed 's/^ *//; s/^Error: //' | cut -c1-300; }

# download (or take the uploaded file), then work out what installing it would do
do_fw_fetch() {     # do_fw_fetch list KEY VERSION MODE | do_fw_fetch file NAME MODE
    TOTAL=1; DONE=0
    if [ "$1" = list ]; then
        mode=$4
        nocry_job $RUN/nocry-fetch.log fetch "$2" "$3" || { MSG=$(last_line $RUN/nocry-fetch.log); return 1; }
        file=$(tail -1 $RUN/nocry-fetch.log)
    elif [ "$1" = usb ]; then
        mode=$3; file=$2; keep=1        # the owner's file on the flash drive: read where it is, never removed
    else
        mode=$3; file=$WORKDIR/$2
    fi
    [ -f "$file" ] || { MSG="firmware file missing"; return 1; }
    echo "$file" > $SESSION/file; echo "$mode" > $SESSION/mode; rm -f $SESSION/report
    if [ "$mode" = slot ]; then set -- --other-slot; else set --; fi
    what="Verifying firmware"
    DONE=0; TOTAL=1; IDLE="unpacking image"     # not the download's numbers any more
    nocry_job $RUN/nocry-plan.log install "$file" --report "$@" || { MSG=$(last_line $RUN/nocry-plan.log); [ -n "$keep" ] || rm -f "$file"; return 1; }
    # the serial number and network address stay off the pages
    grep '^[a-z_]*=' $RUN/nocry-plan.log | grep -v '^note=sn_mac' > $SESSION/report
    MSG="verified; nothing written yet"
}

do_fw_install() {
    file=$(cat $SESSION/file 2>/dev/null); mode=$(cat $SESSION/mode 2>/dev/null)
    [ -f "$file" ] || { MSG="no verified firmware pending"; return 1; }
    if [ "$mode" = slot ]; then set -- --other-slot; else set --; fi
    TOTAL=$(sed -n 's/^to_write=//p' $SESSION/report); TOTAL=${TOTAL:-1}; DONE=0; IDLE="unpacking image"
    nocry_job $RUN/nocry-install.log install "$file" --yes "$@" || { MSG=$(last_line $RUN/nocry-install.log); return 1; }
    MSG=$(last_line $RUN/nocry-install.log)
    session_off
}

# --- the rescue system stored on the board (docs/nocryboot.md) ---------------------------
# Two copies, one in the last 50 MiB of each root file system partition: nothing else writes
# there (a system image ends far before it), so firmware updates, a factory reset and a
# damaged data partition leave them alone. Hold the screen at power-on and the nocryboot
# loader (0.4 or later, Nebula Pad) starts the first copy whose checksums are right.
# When the rescue system starts and finds one copy good and the other missing or damaged, it
# puts the good one there too (rescue-heal), so one overwritten slot does not cost the rescue
# system; taking it away on purpose is rescue-remove, which takes both.
# Loader 0.2 instead read a file on the data partition, found through a note in the third
# sector of "ota"; those are removed once the loader on the board is no longer 0.2.
RESCUE_OLD=nocry-rescue/rescue.uImage
loader_02() { dd if="$DISK" bs=512 skip=34 count=48 2>/dev/null | grep -q "nocryboot-loader 0\.2 "; }
# a nocryboot that looks for the rescue system somewhere else than where it is kept now
loader_old() { dd if="$DISK" bs=512 skip=34 count=48 2>/dev/null | grep -q "nocryboot-loader 0\.[123] "; }
rescue_status() {
    any=no
    for n in rootfs rootfs2; do
        k=a; [ $n = rootfs2 ] && k=b
        r=no; p=$(part $n) && r=$(nocry-rescue-copy status "$p" 2>/dev/null)
        case "$r" in
          yes*) set -- $r; echo "copy_$k=yes"; echo "bytes=$2"; echo "version_$k=$3"; any=yes ;;
          damaged) echo "copy_$k=damaged"; [ $any = no ] && any=damaged ;;
          *) echo "copy_$k=no" ;;
        esac
    done
    echo "stored=$any"
    loader_02 && echo "loader_reads=file"
    loader_old && echo "loader_old=yes"        # it will not find these copies: nocryboot 0.4 does
    return 0
}
rescue_heal() {
    [ -d $LOCK ] && return 0
    a=$(part rootfs) && b=$(part rootfs2) || return 0
    sa=$(nocry-rescue-copy status "$a" 2>/dev/null); sb=$(nocry-rescue-copy status "$b" 2>/dev/null)
    case "$sa|$sb" in
      yes*"|"yes*) echo "healed=no" ;;                       # both good
      yes*"|"*) if nocry-rescue-copy copy "$a" "$b" >/dev/null 2>&1; then echo "healed=b"; else echo "healed=failed"; fi ;;
      *"|"yes*) if nocry-rescue-copy copy "$b" "$a" >/dev/null 2>&1; then echo "healed=a"; else echo "healed=failed"; fi ;;
      *) echo "healed=no" ;;                                 # none to copy from: taken away, or never stored
    esac
    # the kept settings likewise
    for pair in "$a $b" "$b $a"; do
        set -- $pair
        if nocry-rescue-copy keep-get "$1" > $RUN/keep.tmp 2>/dev/null && ! nocry-rescue-copy keep-get "$2" >/dev/null 2>&1; then nocry-rescue-copy keep-put "$2" $RUN/keep.tmp 2>/dev/null; fi
    done
    rm -f $RUN/keep.tmp; sync
}
rescue_install() {
    [ -d $LOCK ] && { echo "another job is still running" >&2; return 1; }
    new=$RUN/rescue.new
    cat > $new || { rm -f $new; echo "could not receive the image (out of memory?)" >&2; return 1; }
    nocry-rescue-copy check $new >/dev/null || { rm -f $new; return 1; }
    ok=0
    for n in rootfs2 rootfs; do
        p=$(part $n) || continue
        if nocry-rescue-copy store "$p" $new >/dev/null; then ok=$((ok + 1)); fi
    done
    rm -f $new; sync
    [ $ok -gt 0 ] || { echo "the rescue image could not be stored in either slot" >&2; return 1; }
    loader_02 || rescue_old_remove
    rescue_status
    echo "copies=$ok"
}
rescue_old_remove() {
    o=$(part ota) && case "$(dd if="$o" bs=512 skip=2 count=1 2>/dev/null | tr -d '\000' | head -1)" in
      nocryboot:rescue:*) dd if=/dev/zero of="$o" bs=512 seek=2 count=1 conv=notrunc 2>/dev/null ;;
    esac
    if [ ! -d $SESSION ] && data_on rw 2>/dev/null; then rm -f "$DATA/$RESCUE_OLD"; data_off; fi
}
rescue_remove() {
    [ -d $LOCK ] && { echo "another job is still running" >&2; return 1; }
    for n in rootfs rootfs2; do p=$(part $n) && nocry-rescue-copy erase "$p" 2>/dev/null; done
    rescue_old_remove
    sync; echo "stored=no"
}

# --- a USB flash drive (mounted by nocry-usb at $USB) ---------------------------------------
# Backups are images as `nocry backup` on a computer writes them (raw, with a .sha256 beside
# them), in the folder nocry-backups; FAT32 holds no file of 4 GiB, so there an image is
# written in pieces (.img.001, .img.002, ...). nocry-image does the copying and checking.
USB=$RUN/nocry-usb
BACKUPS=nocry-backups
ROOM=52428800           # the last 50 MiB of a root file system partition: a copy of the rescue system
usb_on() { [ "$(nocry-usb status 2>/dev/null | sed -n 's/^mounted=//p')" = yes ] || { echo "no USB flash drive is mounted" >&2; return 1; }; }
usb_val() { nocry-usb status 2>/dev/null | sed -n "s/^$1=//p"; }
# a file on the drive; nothing that climbs out of it. Sets F (full path).
usb_file() {
    case "/$1/" in */../*|*/./*) echo "bad path" >&2; return 1 ;; esac
    F=$USB/${1#/}
}
disk_bytes() { echo $(( $(cat $SYS/block/$(basename $DISK)/size) * 512 )); }
part_bytes() { p=$(part "$1") || return 1; echo $(( $(cat $SYS/class/block/$(basename "$p")/size) * 512 )); }
part_start() { p=$(part "$1") || return 1; echo $(( $(cat $SYS/class/block/$(basename "$p")/start) * 512 )); }
part_names() { for u in $SYS/class/block/mmcblk0p*/uevent; do sed -n 's/^PARTNAME=//p' "$u" 2>/dev/null; done; }
usb_targets() {
    printf 'full\t%s\n' "$(disk_bytes)"
    for n in $(part_names); do printf '%s\t%s\n' "$n" "$(part_bytes "$n")"; done
}
img_val() { nocry-image info "$1" 2>/dev/null | sed -n "s/^$2=//p"; }
# what an image on the drive is: sets KIND (full, part or nothing), PART, BYTES
classify() {    # classify IMAGE-PATH (without .001)
    KIND=; PART=; BYTES=$(img_val "$1" bytes); [ -n "$BYTES" ] || return 1
    if [ "$BYTES" = "$(disk_bytes)" ]; then KIND=full; return 0; fi
    for n in $(part_names); do
        case "$1" in *-"$n".img) [ "$BYTES" = "$(part_bytes "$n")" ] && { KIND=part; PART=$n; return 0; } ;; esac
    done
    return 1
}
usb_list() {
    usb_on || return 1
    case "$1" in
      backups)
        find $USB -maxdepth 3 -type f \( -name '*.img' -o -name '*.img.001' \) 2>/dev/null | sort -r | head -80 | while IFS= read -r f; do
            b=${f%.001}
            classify "$b" || continue
            printf '%s\t%s\t%s\t%s\t%s\n' "$KIND" "$PART" "$BYTES" "$(img_val "$b" checksum)" "${b#$USB/}"
        done ;;
      fw)
        find $USB -maxdepth 3 -type f \( -iname '*.img' -o -iname '*.ingenic' \) -size +1024k 2>/dev/null | sort | head -80 | while IFS= read -r f; do
            # Creality's update files are 7z archives, .ingenic packages are zip archives
            case "$(dd if="$f" bs=1 count=2 2>/dev/null)" in 7z|PK) printf '%s\t%s\n' "$(ls -l "$f" | awk '{print $5}')" "${f#$USB/}" ;; esac
        done ;;
      *) echo "usage: nocry-rescue-do usb-list backups|fw" >&2; return 2 ;;
    esac
}
# is the identity record in a whole-storage image that of this board?
same_identity() {   # same_identity IMAGE-PATH
    f=$1; [ -f "$f" ] || f=$1.001
    s=$(part sn_mac) || return 1
    [ "$(dd if="$f" bs=512 skip=$(( $(part_start sn_mac) / 512 )) count=1 2>/dev/null | md5sum)" = "$(dd if="$s" bs=512 count=1 2>/dev/null | md5sum)" ]
}
usb_info() {
    usb_on || return 1; usb_file "$1" || return 1
    classify "$F" || { echo "that file is not a backup of this board's storage or of one of its partitions" >&2; return 1; }
    echo "kind=$KIND"; echo "part=$PART"; echo "bytes=$BYTES"; echo "pieces=$(img_val "$F" pieces)"; echo "checksum=$(img_val "$F" checksum)"
    if [ $KIND = full ]; then if same_identity "$F"; then echo "identity=same"; else echo "identity=different"; fi; fi
}
# runs nocry-image as a job: progress from its progress file, stopped politely on Cancel
image_job() {
    pf=$RUN/nocry-image.progress; rm -f $pf
    nocry-image "$@" --progress $pf > $RUN/nocry-image.out 2> $RUN/nocry-image.err &
    np=$!
    while kill -0 $np 2>/dev/null; do
        [ -e $STOP ] && kill -TERM $np 2>/dev/null
        l=$(cat $pf 2>/dev/null)        # "<phase> <done> <total>"
        if [ -n "$l" ]; then
            TOTAL=${l##* }; l=${l% *}; DONE=${l##* }
            job_state running "$what" "$DONE" "$TOTAL" "${l% *}"
        fi
        sleep 1
    done
    wait $np
}
do_usb_backup() {   # do_usb_backup full|PARTITION
    TOTAL=1; DONE=0
    if [ "$1" = full ]; then dev=$DISK; size=$(disk_bytes); else dev=$(part "$1") && size=$(part_bytes "$1") || { MSG="no $1 partition"; return 1; }; fi
    mkdir -p "$USB/$BACKUPS" || { MSG="cannot create the folder $BACKUPS on the drive"; return 1; }
    m=$(dd if="$(part sn_mac)" bs=512 count=1 2>/dev/null | tr '\000' '\n' | head -1 | cut -d';' -f3 | tr 'A-Z ' 'a-z-' | tr -cd 'a-z0-9-' | cut -c1-24); [ -n "$m" ] || m=board
    grep -q '^mode=client' $RUN/nocry-wifi.state 2>/dev/null && clock >/dev/null 2>&1     # a date for the name, if the network has one
    if [ "$(date +%Y)" -ge 2025 ]; then stamp=$(date +%Y%m%d-%H%M); else stamp=; fi
    k=1
    while :; do      # a name that is free
        if [ -n "$stamp" ] && [ $k = 1 ]; then name=$m-$stamp-$1.img; else name=$m-${stamp:+$stamp-}$(printf '%03d' $k)-$1.img; fi
        [ -e "$USB/$BACKUPS/$name" ] || [ -e "$USB/$BACKUPS/$name.001" ] || break
        k=$((k + 1))
    done
    set --
    [ "$(usb_val fs)" = FAT ] && set -- --split ${NOCRY_SPLIT:-4293918720}      # FAT32: no file of 4 GiB
    image_job save "$dev" 0 "$size" "$USB/$BACKUPS/$name" "$@"; rc=$?
    sync
    if [ $rc = 0 ]; then
        DONE=$size; TOTAL=$size
        n=$(sed -n 's/^pieces=//p' $RUN/nocry-image.out)
        MSG="saved and verified: $BACKUPS/$name"; [ "${n:-1}" -gt 1 ] && MSG="$MSG ($n pieces: .001 to .$(printf '%03d' $n))"
        return 0
    fi
    [ $rc = 3 ] && MSG="cancelled; the incomplete file was removed" || MSG=$(last_line $RUN/nocry-image.err | sed 's/^nocry-image: //')
    return 1
}
do_usb_restore() {  # do_usb_restore IMAGE-PATH KIND PART
    TOTAL=1; DONE=0
    if [ "$2" = full ]; then dev=$DISK; base=; names="rootfs rootfs2"; else dev=$(part "$3") || { MSG="no $3 partition"; return 1; }; base=0; names=$3; fi
    img=$1; kind=$2; size=$(img_val "$1" bytes)
    # a good copy of the rescue system on the board is not replaced by whatever the image has there
    set --
    for n in $names; do
        case $n in rootfs|rootfs2) ;; *) continue ;; esac
        p=$(part $n) || continue
        case "$(nocry-rescue-copy status "$p" 2>/dev/null)" in yes*) ;; *) continue ;; esac
        o=$(( ${base:-$(part_start $n)} + $(part_bytes $n) - ROOM ))
        set -- "$@" --skip $o:$ROOM
    done
    image_job load "$img" "$dev" 0 "$size" "$@"; rc=$?
    sync
    [ "$kind" = full ] && { blockdev --rereadpt $DISK 2>/dev/null || partprobe $DISK 2>/dev/null; }
    if [ $rc = 0 ]; then
        DONE=$size; TOTAL=$size
        MSG="restored and verified ($(( $(sed -n 's/^written=//p' $RUN/nocry-image.out) >> 20 )) MiB differed and were written)"
        return 0
    fi
    [ $rc = 3 ] && MSG="cancelled before completion" || MSG=$(last_line $RUN/nocry-image.err | sed 's/^nocry-image: //')
    return 1
}
# the board's storage must be nobody's while an image of it is read or written
storage_free() {
    [ -d $LOCK ] && { echo "another job is still running" >&2; return 1; }
    [ -d $SESSION ] && { echo "a firmware install is pending; finish or discard it first" >&2; return 1; }
    grep -q " $DATA " /proc/mounts && umount $DATA 2>/dev/null
    return 0
}

# --- updates from this project's releases on GitHub -------------------------------------------
# `nocry self-update check` asks GitHub what the newest release carries (size and SHA-256 of
# each file come from GitHub's own list); what it says is kept in $RUN/nocry-update.rel. A
# download is only used when size and SHA-256 match (nocry self-update fetch), and then the
# file is checked again for what it is: the rescue image by the CRCs in its header, the loader
# by its size, its name for this board family and its version. The loader is installed by
# `nocry loader --install`, with all its own checks (the loader on the board is one it knows,
# the factory loader is kept, every write is read back).
UPD=$RUN/nocry-update.rel
UPDIR=$RUN/nocry-update
vkey() {    # a version as something that sorts: 0.2.0-beta.2 < 0.2.0-rc.1 < 0.2.0; 0.4 too
    echo "$1" | awk '{ v = $0; sub(/^[vV]/, "", v); pre = ""; i = index(v, "-"); if (i) { pre = substr(v, i + 1); v = substr(v, 1, i - 1) }
        n = split(v, m, "."); rank = 3; num = 0
        if (pre != "") { k = pre; j = index(pre, "."); if (j) { k = substr(pre, 1, j - 1); num = substr(pre, j + 1) + 0 }
            rank = (k == "rc") ? 2 : (k == "beta") ? 1 : 0 }
        printf "%05d%05d%05d%d%05d\n", m[1] + 0, m[2] + 0, m[3] + 0, rank, num }'
}
newer() { [ -n "$1" ] && [ "$(vkey "$1")" \> "$(vkey "${2:-0}")" ]; }      # newer OFFERED INSTALLED
upd() { sed -n "s/^$1=//p" $UPD 2>/dev/null | head -1; }
# the loader on the board: "nocryboot <version> <family>", "factory", or nothing if unknown
loader_now() {
    l=$(dd if="$DISK" bs=512 skip=34 count=48 2>/dev/null | tr -c 'a-z0-9. -' '\n' | sed -n 's/^.*nocryboot-loader \([0-9.]*\) \([a-z0-9]*\).*$/\1 \2/p' | head -1)
    if [ -n "$l" ]; then echo "nocryboot $l"; else echo factory; fi
}
rescue_now() {  # the newest version among the stored copies; nothing if none is stored
    best=
    for n in rootfs rootfs2; do
        p=$(part $n) || continue
        set -- $(nocry-rescue-copy status "$p" 2>/dev/null)
        [ "$1" = yes ] && { [ -z "$best" ] || newer "$3" "$best"; } && best=${3:-0}
    done
    echo "$best"
}
update_check() {
    [ -x /usr/sbin/nocry ] || { echo "error=this image has no update check"; return 1; }
    if [ "$1" = again ] || [ ! -s $UPD ]; then
        clock >/dev/null 2>&1          # certificates need the date
        export HOME=$RUN/nocry-list XDG_DATA_HOME=$RUN/nocry-list; mkdir -p $HOME
        if ! /usr/sbin/nocry self-update check > $UPD.new 2> $UPD.err; then
            rm -f $UPD.new; echo "error=$(last_line $UPD.err)"; return 1
        fi
        mv $UPD.new $UPD
    fi
    rel=$(upd release); have=$(rescue_now); set -- $(loader_now)
    echo "release=$rel"
    echo "rescue_installed=${have:-none}"; echo "rescue_latest=$rel"
    if [ -n "$(upd rescue_url)" ] && newer "$rel" "$have"; then echo "rescue_update=yes"; else echo "rescue_update=no"; fi
    if [ "$1" = nocryboot ]; then
        lv=$(upd loader_$3_version)
        echo "loader_installed=$2"; echo "loader_family=$3"; echo "loader_latest=$lv"
        if [ -n "$(upd loader_$3_url)" ] && newer "$lv" "$2"; then echo "loader_update=yes"; else echo "loader_update=no"; fi
    else
        # the factory loader: putting nocryboot there is a decision of its own (Boot loader), not an update
        echo "loader_installed=factory"; echo "loader_update=no"
    fi
}
do_update_rescue() {
    TOTAL=1; DONE=0; IDLE="contacting GitHub"
    url=$(upd rescue_url); sha=$(upd rescue_sha256); bytes=$(upd rescue_bytes); rel=$(upd release)
    [ -n "$url" ] && [ -n "$sha" ] && [ -n "$bytes" ] || { MSG="no rescue image in the newest release; check for updates again"; return 1; }
    rm -rf $UPDIR; mkdir -p $UPDIR
    export HOME=$RUN/nocry-list XDG_DATA_HOME=$RUN/nocry-list; mkdir -p $HOME
    nocry_job $RUN/nocry-update.log self-update fetch "$url" "$sha" "$bytes" $UPDIR/rescue.uImage || { MSG=$(last_line $RUN/nocry-update.log); rm -rf $UPDIR; return 1; }
    what="Updating rescue image"; DONE=0; TOTAL=1
    job_state running "$what" 0 1 "checking the image"
    nocry-rescue-copy check $UPDIR/rescue.uImage >/dev/null 2>&1 || { MSG="the downloaded file is not a rescue image this board can start; nothing was changed"; rm -rf $UPDIR; return 1; }
    NOSTOP=1; ok=0
    for n in rootfs2 rootfs; do     # one after the other: the other copy stays good meanwhile
        p=$(part $n) || continue
        job_state running "$what" 0 1 "writing the copy behind $n"
        if nocry-rescue-copy store "$p" $UPDIR/rescue.uImage >/dev/null 2>&1; then ok=$((ok + 1)); else MSG="the copy behind $n could not be written; the other copy was left as it was"; break; fi
    done
    rm -rf $UPDIR; sync
    [ $ok -gt 0 ] || { MSG=${MSG:-"no copy could be written"}; return 1; }
    [ $ok = 2 ] || return 1
    MSG="rescue $rel stored and verified ($ok copies); it runs from the next start of the rescue system"
}
do_update_loader() {
    TOTAL=1; DONE=0; IDLE="contacting GitHub"
    set -- $(loader_now)
    [ "$1" = nocryboot ] || { MSG="the board has the factory loader; install nocryboot under Boot loader first"; return 1; }
    fam=$3
    url=$(upd loader_${fam}_url); sha=$(upd loader_${fam}_sha256); bytes=$(upd loader_${fam}_bytes); lv=$(upd loader_${fam}_version)
    [ -n "$url" ] && [ -n "$sha" ] && [ "$bytes" = 24576 ] || { MSG="no loader for this board in the newest release; check for updates again"; return 1; }
    newer "$lv" "$2" || { MSG="nocryboot $2 is already the newest"; return 1; }
    # the new loader must find the rescue system where it looks: both copies good first
    for n in rootfs rootfs2; do
        p=$(part $n) && case "$(nocry-rescue-copy status "$p" 2>/dev/null)" in yes*) ;; *) MSG="store the rescue image first (Updates, or nocry rescue --install): a copy behind $n is missing"; return 1 ;; esac
    done
    rm -rf $UPDIR; mkdir -p $UPDIR/images/nocryboot
    f=$UPDIR/images/nocryboot/nocryboot-$fam.bin
    export HOME=$RUN/nocry-list XDG_DATA_HOME=$RUN/nocry-list; mkdir -p $HOME
    nocry_job $RUN/nocry-update.log self-update fetch "$url" "$sha" "$bytes" "$f" || { MSG=$(last_line $RUN/nocry-update.log); rm -rf $UPDIR; return 1; }
    what="Updating boot loader"; DONE=0; TOTAL=1
    job_state running "$what" 0 1 "checking the loader"
    # what it is, beyond the checksum: exactly 24 KiB, nocryboot of this version for this family, not a test build
    [ "$(wc -c < "$f")" = 24576 ] && [ "$(dd if="$f" bs=4 count=1 2>/dev/null)" = LPSM ] &&
        tr -c 'a-z0-9. -' '\n' < "$f" | grep -q "^.*nocryboot-loader $lv $fam\$" || { MSG="the downloaded file is not nocryboot $lv for this board; nothing was changed"; rm -rf $UPDIR; return 1; }
    NOSTOP=1
    job_state running "$what" 0 1 "writing the loader: do not power off"
    NOCRY_BOARD_DISK=$DISK NOCRY_IMAGES=$UPDIR/images /usr/sbin/nocry loader --install --yes > $RUN/nocry-update.log 2>&1; rc=$?
    rm -rf $UPDIR; sync
    set -- $(loader_now)
    if [ $rc = 0 ] && [ "$2" = "$lv" ]; then MSG="nocryboot $lv installed and read back; the factory loader is still kept on the board"; return 0; fi
    MSG="$(last_line $RUN/nocry-update.log) (the loader on the board is now: $*)"
    return 1
}

# the touch calibration: beside each copy, so it survives what the copies survive
cal_get() {
    for n in rootfs rootfs2; do p=$(part $n) && nocry-rescue-copy keep-get "$p" 2>/dev/null && return 0; done
    data_on ro 2>/dev/null || return 1         # where rescue kept it before
    cat "$DATA/nocry-rescue/touch.cal" 2>/dev/null; rc=$?; data_off; return $rc
}
cal_put() {
    cat > $RUN/cal.new; ok=1
    for n in rootfs rootfs2; do p=$(part $n) && nocry-rescue-copy keep-put "$p" $RUN/cal.new 2>/dev/null && ok=0; done
    rm -f $RUN/cal.new; [ $ok = 0 ] || echo "the calibration could not be saved" >&2; return $ok
}

case "$1" in
  usb-status) nocry-usb status ;;
  usb-eject)
    [ -d $LOCK ] && { echo "a job is running; let it finish first" >&2; exit 1; }
    case "$(cat $SESSION/file 2>/dev/null)" in $USB/*) echo "a firmware install from the drive is pending; install or discard it first" >&2; exit 1 ;; esac
    nocry-usb eject ;;
  usb-format)
    [ -d $LOCK ] && { echo "a job is running; let it finish first" >&2; exit 1; }
    case "$(cat $SESSION/file 2>/dev/null)" in $USB/*) echo "a firmware install from the drive is pending; install or discard it first" >&2; exit 1 ;; esac
    nocry-usb format "$2" ;;
  usb-targets) usb_targets ;;
  usb-list) usb_list "$2" ;;
  usb-info) usb_info "$2" ;;
  usb-backup)
    usb_on || exit 1
    [ "$(usb_val readonly)" = yes ] && { echo "the drive is mounted read-only (an NTFS volume that Windows did not shut down cleanly, or a write-protected drive)" >&2; exit 1; }
    if [ "$2" = full ]; then need=$(disk_bytes); t="Backing up eMMC"; else need=$(part_bytes "$2") || { echo "no such partition" >&2; exit 1; }; t="Backing up $2"; fi
    free=$(usb_val free)
    [ "${free:-0}" -gt $((need + 1048576)) ] || { echo "not enough free space on the drive: $((need >> 20)) MiB needed, $(( ${free:-0} >> 20 )) MiB free" >&2; exit 1; }
    storage_free || exit 1
    RISK="The incomplete backup file is removed. Nothing on the board is changed."
    run_job "$t" do_usb_backup "$2" ;;
  usb-restore)
    usb_on || exit 1; usb_file "$2" || exit 1
    classify "$F" || { echo "that file is not a backup of this board's storage or of one of its partitions" >&2; exit 1; }
    if [ $KIND = full ]; then
        same_identity "$F" || { echo "this backup is from another board (its identity record differs): restoring it would replace this board's serial number. Use nocry on a computer for that." >&2; exit 1; }
        t="Restoring eMMC"
        RISK="The storage is partly overwritten and the board may not start. Run the restore again to completion. If the board no longer starts at all, recover it over USB with nocry on a computer."
    else
        [ "$PART" = sn_mac ] && { echo "the identity record is not restored from here; use nocry on a computer" >&2; exit 1; }
        t="Restoring $PART"
        RISK="The partition $PART is partly overwritten. Run the restore again to completion."
    fi
    storage_free || exit 1
    run_job "$t" do_usb_restore "$F" "$KIND" "$PART" ;;
  fw-check-usb)
    case "$3" in keep|slot) ;; *) echo "usage: nocry-rescue-do fw-check-usb FILE keep|slot" >&2; exit 2 ;; esac
    usb_on || exit 1; usb_file "$2" || exit 1
    [ -f "$F" ] || { echo "no such file on the drive" >&2; exit 1; }
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    session_on || exit 1
    RISK="Verification only: nothing on the board has been changed."
    run_job "Verifying firmware" do_fw_fetch usb "$F" "$3" ;;
  cal-get) cal_get ;;
  cal-put) cal_put ;;
  status) status ;;
  health) health ;;
  rescue-status) rescue_status ;;
  rescue-install) rescue_install ;;
  rescue-remove) rescue_remove ;;
  rescue-heal) rescue_heal ;;
  update-check) update_check "$2" ;;
  update-rescue)
    [ -s $UPD ] || { echo "check for updates first" >&2; exit 1; }
    [ -d $SESSION ] && { echo "a firmware install is pending; finish or discard it first" >&2; exit 1; }
    RISK="If cancelled during the download nothing has changed."
    run_job "Downloading rescue image" do_update_rescue ;;
  update-loader)
    [ -s $UPD ] || { echo "check for updates first" >&2; exit 1; }
    [ -d $SESSION ] && { echo "a firmware install is pending; finish or discard it first" >&2; exit 1; }
    RISK="If cancelled during the download nothing has changed."
    run_job "Downloading boot loader" do_update_loader ;;
  fw-list)
    # the list lives in memory between requests; "refresh" asks the internet for the current one
    export XDG_DATA_HOME=$RUN/nocry-list HOME=$RUN/nocry-list; mkdir -p $XDG_DATA_HOME
    [ -x /usr/sbin/nocry ] || exit 1
    if [ "$2" = refresh ]; then clock; /usr/sbin/nocry catalog --refresh >/dev/null 2>$RUN/nocry-list.err || { tail -1 $RUN/nocry-list.err | sed 's/^Error: //' >&2; exit 1; }; fi
    # for this board: its own printer type, and NebulaOS where that is made for it
    model=$(status | sed -n 's/^model=//p')
    case "$model" in "Nebula Pad") key=NEBULA ;; *) key=$model ;; esac
    /usr/sbin/nocry catalog --tsv 2>/dev/null | awk -F '\t' -v k="$key" '$1 == k || ($1 == "NEBULAOS" && (k == "F005" || k == "NEBULA"))' ;;
  fw-fetch)
    case "$4" in keep|slot) ;; *) echo "usage: nocry-rescue-do fw-fetch KEY VERSION keep|slot" >&2; exit 2 ;; esac
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    session_on || exit 1
    mkdir -p $WORKDIR/data/nocry; cp $RUN/nocry-list/nocry/catalog.json $WORKDIR/data/nocry/ 2>/dev/null   # the list the page showed
    clock
    RISK="Download and verification only: nothing on the board has been changed."
    run_job "Downloading firmware" do_fw_fetch list "$2" "$3" "$4" ;;
  fw-upload-path)
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    session_on || exit 1
    echo "$WORKDIR/upload.bin" ;;
  fw-check)
    case "$3" in keep|slot) ;; *) echo "usage: nocry-rescue-do fw-check NAME keep|slot" >&2; exit 2 ;; esac
    [ -d $SESSION ] || { echo "no upload pending" >&2; exit 1; }
    nocry_env
    # nocry tells the kinds of firmware file apart by their contents, and one kind by its name
    n=$(echo "$2" | tr -cd 'A-Za-z0-9._-'); [ -n "$n" ] || n=firmware.img
    mv $WORKDIR/upload.bin "$WORKDIR/$n" 2>/dev/null || { echo "upload missing" >&2; exit 1; }
    RISK="Verification only: nothing on the board has been changed."
    run_job "Verifying firmware" do_fw_fetch file "$n" "$3" ;;
  fw-report) cat $SESSION/report 2>/dev/null; [ -f $SESSION/mode ] && echo "mode=$(cat $SESSION/mode)" ;;
  fw-install)
    [ -s $SESSION/report ] || { echo "no verified firmware pending" >&2; exit 1; }
    nocry_env
    if [ "$(cat $SESSION/mode)" = slot ]; then
        RISK="The target slot is left incomplete and cannot boot until the install is run again. The active slot is not affected."
    else
        RISK="The active slot is being overwritten and is incomplete. If cancelled, the board will not boot until the install is run again to completion; rescue can do that."
    fi
    run_job "Installing firmware" do_fw_install ;;
  fw-discard)
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    [ -d $SESSION ] && session_off ;;
  loader|logo)
    [ -x /usr/sbin/nocry ] || { echo "this rescue image has no installer (nocry is missing)" >&2; exit 1; }
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    export NOCRY_BOARD_DISK=$DISK NOCRY_IMAGES=/usr/share/nocry/images HOME=$RUN/nocry-list XDG_DATA_HOME=$RUN/nocry-list
    mkdir -p $HOME
    case "$1 $2" in
      "loader ") /usr/sbin/nocry loader 2>&1 ;;
      "loader install") /usr/sbin/nocry loader --install --yes 2>&1 ;;
      "loader factory") /usr/sbin/nocry loader --factory --yes 2>&1 ;;
      "logo ") /usr/sbin/nocry logo 2>&1 ;;
      "logo nocry") /usr/sbin/nocry logo --nocry --yes 2>&1 ;;
      "logo firmware") /usr/sbin/nocry logo --firmware --yes 2>&1 ;;
      *) echo "usage: nocry-rescue-do loader [install|factory] | logo [nocry|firmware]" >&2; exit 2 ;;
    esac ;;
  check)
    case "$2" in data) n=userdata; t="userdata (fsck)" ;; settings) n=rootfs_data; t="rootfs_data (fsck)" ;; *) echo "usage: nocry-rescue-do check data|settings" >&2; exit 2 ;; esac
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    [ -d $SESSION ] && session_off      # a firmware file held for installing: let it go, the partition must be free
    grep -q " $DATA " /proc/mounts && umount $DATA 2>/dev/null
    NOSTOP=1        # e2fsck is not interrupted
    RISK="An interrupted repair can leave the file system in a worse state. Let it finish."
    run_job "Checking $t" do_check $n ;;
  ls)
    inside "${2:-/}" || exit 1; data_on ro || exit 1
    [ -d "$P" ] || { data_off; echo "no such folder" >&2; exit 1; }
    ls -lA "$P" 2>/dev/null | awk 'NR > 1 || $1 !~ /^total/ { t = substr($1, 1, 1); if (t != "d" && t != "-") next; n = $9; for (i = 10; i <= NF; i++) n = n " " $i; printf "%s\t%s\t%s\n", (t == "d" ? "d" : "f"), $5, n }'
    data_off ;;
  get)
    inside "$2" || exit 1; data_on ro || exit 1
    if [ -f "$P" ] && [ ! -L "$P" ]; then cat "$P"; rc=$?; else echo "no such file" >&2; rc=1; fi
    data_off; exit $rc ;;
  put)
    inside "$2" || exit 1; data_on rw || exit 1
    if [ -d "$(dirname "$P")" ] && [ ! -d "$P" ] && [ ! -L "$P" ]; then cat > "$P.nocry-new" && mv "$P.nocry-new" "$P"; rc=$?; else echo "no such folder" >&2; rc=1; fi
    data_off; exit $rc ;;
  rm)
    inside "$2" || exit 1; [ "$P" != "$DATA/" ] || exit 1; data_on rw || exit 1
    if [ -d "$P" ] && [ ! -L "$P" ]; then rmdir "$P" 2>/dev/null || { echo "the folder is not empty" >&2; false; }; else rm -f "$P"; fi; rc=$?
    data_off; exit $rc ;;
  bundle) bundle "$2" ;;
  wifi-save) wifi_save ;;
  restart)
    [ -d $LOCK ] && { echo "a job is running; cancel it or let it finish first" >&2; exit 1; }
    sync; nocry-usb eject >/dev/null 2>&1
    ( sleep 2; reboot -f ) </dev/null >/dev/null 2>&1 & ;;
  switch)
    case "$2" in a|b) ;; *) echo "slot must be a or b" >&2; exit 2 ;; esac
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    slot "$2" | grep -q "^$2_complete=yes" || { echo "slot $2 has no complete firmware; it would not boot" >&2; exit 1; }
    r=$(ok "set_active:$2") || { echo "$r" >&2; exit 1; } ;;
  copy)
    case "$2" in a|b) ;; *) echo "slot must be a or b" >&2; exit 2 ;; esac
    slot "$2" | grep -q "^$2_complete=yes" || { echo "slot $2 has no complete firmware to copy" >&2; exit 1; }
    if [ "$2" = a ]; then o=B; else o=A; fi
    RISK="Slot $o is left incomplete and cannot boot until the copy is run again."
    run_job "Copying slot $(echo "$2" | tr ab AB) to slot $o" do_copy "$2" ;;
  reset)
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    [ -d $SESSION ] && session_off      # the data partition must not be mounted while it is erased
    case "$2" in
      mods) RISK="rootfs_data is left partly erased. The firmware may not boot correctly until the wipe is run to completion."
            run_job "Wiping system overlay" do_reset mods ;;
      all)  RISK="rootfs_data and userdata are left partly erased; erased data is not recoverable. The firmware may not boot correctly until the reset is run to completion."
            run_job "Factory reset" do_reset all ;;
      *) echo "usage: nocry-rescue-do reset mods|all" >&2; exit 2 ;;
    esac ;;
  job) cat $JOB 2>/dev/null || echo "state=none" ;;
  cancel) [ -d $LOCK ] && : > $STOP ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
