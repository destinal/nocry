#!/bin/sh
# nocry-rescue-do: what the rescue system's web pages can do to the board, in one place
# (docs/nocry-rescue.md). Everything that touches the storage goes through nocry-fbd's own
# commands (nocry-fbd --exec), so reading, comparing and verified writing are not done twice.
#
#   nocry-rescue-do status          the board and its two firmware slots, as key=value lines
#   nocry-rescue-do switch a|b      make that slot the one that starts
#   nocry-rescue-do copy a|b        copy that slot's firmware over the other slot       (a job)
#   nocry-rescue-do reset mods|all  blank the settings overlay, or it and all files     (a job)
#   nocry-rescue-do check data|settings   check and repair that file system (e2fsck)      (a job)
#   nocry-rescue-do health          the storage chip's own wear report, the data partition's state
#   nocry-rescue-do ls DIR          a folder of the data partition: "d|f<TAB>size<TAB>name" lines
#   nocry-rescue-do get FILE        a file of the data partition, to standard output
#   nocry-rescue-do put FILE        standard input into a file of the data partition
#   nocry-rescue-do rm FILE         delete a file (or an empty folder) of the data partition
#   nocry-rescue-do bundle logs|config|identity   a download, to standard output (tar.gz; identity: the raw record)
#   nocry-rescue-do wifi-save       write the Wi-Fi network the board is on into the installed firmware's settings
#   nocry-rescue-do restart         leave the rescue system: restart the board normally
#   nocry-rescue-do fw-list [refresh]   firmware that can be installed here: key, name, version, date, bytes, file (tabs)
#   nocry-rescue-do fw-fetch KEY VERSION SLOT|KEEP   download it and work out what installing would do   (a job)
#   nocry-rescue-do fw-upload-path  where the page stores an uploaded firmware file (starts an install session)
#   nocry-rescue-do fw-check NAME SLOT|KEEP        the same for an uploaded file                         (a job)
#   nocry-rescue-do fw-report       what the check found (key=value lines), or nothing
#   nocry-rescue-do fw-install      install what was checked                                              (a job)
#   nocry-rescue-do fw-discard      forget it and remove the downloaded file
#   nocry-rescue-do loader [install|factory]   the boot loader: say what is there, or change it
#   nocry-rescue-do logo [nocry|firmware]      the boot logo: say what is there, or change it
#   nocry-rescue-do rescue-status   is the rescue system stored on the board, and will the loader find it?
#   nocry-rescue-do rescue-install  standard input (a rescue image) -> the data partition, and the loader's note
#   nocry-rescue-do rescue-remove   take both away again
#   nocry-rescue-do job             the running or last job: state=, what=, done=, total=, message=
#   nocry-rescue-do cancel          ask the running job to stop at its next safe point
#
# A job runs on its own (it outlives the page that started it), one at a time, and records its
# progress in /run/nocry-job. Stopping one leaves what its `risk=` line says.

DISK=${NOCRY_DISK:-/dev/mmcblk0}
FBD=${NOCRY_FBD:-/usr/sbin/nocry-fbd}
RUN=${NOCRY_RUN:-/run}
JOB=$RUN/nocry-job
LOCK=$RUN/nocry-job.lock
STOP=$RUN/nocry-job.stop
STEP=1000000        # 16 MiB per command (hex), so progress and Cancel are never far away

fb() { "$FBD" --exec "$1" "$DISK" 2>/dev/null; }                 # prints "OKAY ..." / "FAIL ..."
ok() { r=$(fb "$1"); case "$r" in OKAY*) echo "${r#OKAY }"; return 0 ;; *) echo "${r#FAIL }"; return 1 ;; esac; }

part() {    # device node of the partition named $1 (a real board), or nothing (a test image)
    for u in /sys/class/block/mmcblk0p*/uevent; do
        grep -q "^PARTNAME=$1\$" "$u" 2>/dev/null && { echo "/dev/$(basename "$(dirname "$u")")"; return 0; }
    done
    return 1
}
size() { s=$(ok "getvar:partition-size:$1") || return 1; printf '%d' "$s"; }    # bytes
sfx() { [ "$1" = b ] && echo 2; }

# first bytes of a partition as hex: head NAME OFFSET COUNT
head_hex() { p=$(part "$1") || return 1; dd if="$p" bs=1 skip="$2" count="$3" 2>/dev/null | hexdump -v -e '/1 "%02x"'; }

# What a slot holds. Prints: complete=yes|no, firmware=<name and version, or what is missing>
slot() {
    x=$(sfx "$1"); miss=
    [ "$(head_hex "rtos$x" 8 4)" = 52544f53 ] || miss="$miss start program,"
    [ "$(head_hex "kernel$x" 0 4)" = 27051956 ] || miss="$miss kernel,"
    [ "$(head_hex "rootfs$x" 0 4)" = 68737173 ] || miss="$miss system,"
    if [ -n "$miss" ]; then
        echo "$1_complete=no"; echo "$1_firmware=incomplete (no${miss%,})"; return
    fi
    echo "$1_complete=yes"
    name="unrecognised firmware"
    m=$RUN/nocry-slot; mkdir -p $m
    if p=$(part "rootfs$x") && mount -t squashfs -o ro "$p" $m 2>/dev/null; then
        if [ -f $m/etc/ota_info ]; then
            b=$(sed -n 's/^ota_board_name=//p' $m/etc/ota_info | tr -d '\r'); v=$(sed -n 's/^ota_version=//p' $m/etc/ota_info | tr -d '\r')
            case "$b" in
                NEBULA) b="Retail Nebula Pad" ;; F005) b="Ender-3 V3 KE" ;; F003) b="CR-10 SE" ;; F004) b="Ender-5 Max" ;;
                CR4CU220812S1?) b="K1 series" ;; F001) b="Ender-3 V3 series" ;;
            esac
            name="Creality $b $v"
        elif grep -q '^ID=nebulaos' $m/usr/lib/os-release 2>/dev/null; then
            name="NebulaOS $(sed -n 's/^VERSION_ID=//p' $m/usr/lib/os-release | tr -d '"\r')"
        fi
        umount $m 2>/dev/null
    fi
    echo "$1_firmware=$name"
}

status() {
    a=$(ok getvar:current-slot) || a=
    echo "active=$a"
    slot a; slot b
    # the identity record: model and mainboard only; serial number and MAC stay off the page
    if p=$(part sn_mac); then
        rec=$(dd if="$p" bs=512 count=1 2>/dev/null | tr -d '\000')
        echo "model=$(echo "$rec" | cut -d';' -f3)"; echo "mainboard=$(echo "$rec" | cut -d';' -f4)"
    fi
    # what the nocryboot loader noted about the last starts (second sector of ota)
    if p=$(part ota); then echo "note=$(dd if="$p" bs=512 skip=1 count=1 2>/dev/null | tr -d '\000' | head -1 | tr -cd 'a-zA-Z0-9:=_-')"; fi
}

job_state() {   # job_state STATE WHAT DONE TOTAL MESSAGE
    printf 'state=%s\nwhat=%s\ndone=%s\ntotal=%s\nmessage=%s\nrisk=%s\n' "$1" "$2" "$3" "$4" "$5" "$RISK" > $JOB.new && { [ -z "$NOSTOP" ] || echo "stoppable=no" >> $JOB.new; mv $JOB.new $JOB; }
}

# run_job NAME FUNCTION ARGS...: takes the lock, runs in the background on its own
run_job() {
    mkdir $LOCK 2>/dev/null || { echo "another job is still running" >&2; exit 1; }
    rm -f $STOP
    what=$1; shift
    job_state running "$what" 0 1 ""
    (
        trap 'rmdir $LOCK 2>/dev/null' EXIT
        if "$@"; then job_state done "$what" "$DONE" "$TOTAL" "$MSG"
        elif [ -e $STOP ]; then job_state cancelled "$what" "$DONE" "$TOTAL" "$MSG"
        else job_state failed "$what" "$DONE" "$TOTAL" "$MSG"; fi
        rm -f $STOP
    ) </dev/null >/dev/null 2>&1 &
}

# one fbd command per 16 MiB over a partition: over NAME SIZE COMMAND-PREFIX (offset and size are appended)
DONE=0; TOTAL=1; MSG=; RISK=; IDLE=; NOSTOP=
over() {
    off=0
    while [ $off -lt "$2" ]; do
        [ -e $STOP ] && { MSG="cancelled before completion"; return 1; }
        n=$(( $2 - off )); [ $n -gt $((0x$STEP)) ] && n=$((0x$STEP))
        r=$(ok "$3:$(printf '%x' $off):$(printf '%x' $n)") || { MSG="$1: $r"; return 1; }
        off=$((off + n)); DONE=$((DONE + n))
        job_state running "$what" "$DONE" "$TOTAL" "$1"
    done
}

do_copy() {     # do_copy FROM(a|b)
    f=$(sfx "$1"); if [ "$1" = a ]; then t=2; else t=; fi
    TOTAL=0
    for p in rtos kernel rootfs; do
        s=$(size "$p$f") && d=$(size "$p$t") || { MSG="cannot read the size of $p"; return 1; }
        [ "$s" = "$d" ] || { MSG="$p$f and $p$t differ in size; the slot cannot be copied"; return 1; }
        TOTAL=$((TOTAL + s))
    done
    for p in rtos kernel rootfs; do
        over "$p$t" "$(size "$p$f")" "nocry-pcopy:$p$f:$p$t" || return 1
    done
    MSG="copied and verified"
}

do_reset() {    # do_reset mods|all
    parts="rootfs_data"; [ "$1" = all ] && parts="rootfs_data userdata"
    TOTAL=0; for p in $parts; do s=$(size "$p") || { MSG="no $p partition"; return 1; }; TOTAL=$((TOTAL + s)); done
    for p in $parts; do over "$p" "$(size "$p")" "nocry-zero:$p" || return 1; done
    MSG="erased and verified"
}

# --- the data partition (userdata, "/usr/data" in the firmware), mounted only while it is used
DATA=$RUN/nocry-files
SESSION=$RUN/nocry-install        # exists while a firmware file is held for installing: data stays mounted
data_on() {     # data_on ro|rw
    if [ -d $SESSION ]; then grep -q " $DATA " /proc/mounts && return 0; fi
    [ -d $LOCK ] && { echo "another job is still running" >&2; return 1; }
    p=$(part userdata) || { echo "no userdata partition" >&2; return 1; }
    mkdir -p $DATA
    grep -q " $DATA " /proc/mounts && umount $DATA 2>/dev/null
    if [ "$1" = rw ]; then mount -t ext4 -o rw "$p" $DATA 2>/dev/null
    else mount -t ext4 -o ro,noload "$p" $DATA 2>/dev/null; fi || {
        echo "userdata has no readable file system (blank after a reset, or damaged: run fsck)" >&2; return 1; }
}
data_off() { sync; [ -d $SESSION ] && return 0; umount $DATA 2>/dev/null; }
# a path inside the data partition; nothing that climbs out of it
inside() {
    case "/$1/" in */../*|*/./*) echo "bad path" >&2; return 1 ;; esac
    P=$DATA/${1#/}
}

do_check() {    # do_check PARTITION: e2fsck, repairing; the report is kept for the page
    p=$(part "$1") || { MSG="no $1 partition"; return 1; }
    TOTAL=1; DONE=0
    if [ "$(dd if="$p" bs=1 skip=1080 count=2 2>/dev/null | hexdump -v -e '/1 "%02x"')" != 53ef ]; then
        MSG="no file system (blank: the firmware creates one at next boot)"; DONE=1; return 0
    fi
    e2fsck -fy "$p" > $RUN/nocry-check.log 2>&1; rc=$?
    DONE=1
    case $rc in
        0) MSG="no errors found" ;;
        1|2|3) MSG="errors found and repaired" ;;
        *) MSG="unrepairable errors remain (e2fsck exit $rc); a factory reset recreates the file system"; return 1 ;;
    esac
}

health() {
    d=/sys/block/mmcblk0/device
    echo "chip=$(cat $d/name 2>/dev/null)"
    # JEDEC: life time estimates A and B in steps of 10 % used (0x01 = 0-10 %, 0x0b = past its life)
    lt=$(cat $d/life_time 2>/dev/null); a=${lt% *}; b=${lt#* }
    pct() { case "$1" in 0x0[1-9]|0x0a) echo $(( ($1 - 1) * 10 ))-$(( $1 * 10 )) ;; 0x0b) echo over-100 ;; *) echo unknown ;; esac; }
    echo "wear_a=$(pct "$a")"; echo "wear_b=$(pct "$b")"
    case "$(cat $d/pre_eol_info 2>/dev/null)" in 0x01) echo "spare=normal" ;; 0x02) echo "spare=80 % of the spare blocks used" ;; 0x03) echo "spare=90 % of the spare blocks used" ;; *) echo "spare=unknown" ;; esac
    if data_on ro 2>/dev/null; then
        df -k $DATA | awk 'END { printf "data_total_mb=%d\ndata_used_mb=%d\ndata_free_mb=%d\n", $2 / 1024, $3 / 1024, $4 / 1024 }'
        echo "data_state=readable"; data_off
    else echo "data_state=no file system"; fi
}

# What a download holds. Paths that exist are taken; both firmwares' layouts are known.
bundle() {
    case "$1" in
      identity) p=$(part sn_mac) || exit 1; dd if="$p" bs=512 count=1 2>/dev/null; return ;;
      backup) gzip -1 -c "$DISK"; return ;;       # the whole storage; unpack it and restore it with nocry on a computer
      logs)   want="printer_data/logs nebulaos/printer_data/logs nebulaos/system creality/userdata/log" ;;
      config) want="printer_data/config nebulaos/printer_data/config nebulaos/nebulascreen nebulascreen creality/userdata/config" ;;
      *) echo "usage: nocry-rescue-do bundle logs|config|identity" >&2; exit 2 ;;
    esac
    data_on ro || exit 1
    have=; for w in $want; do [ -e "$DATA/$w" ] && have="$have $w"; done
    T=$RUN/nocry-bundle; rm -rf $T; mkdir -p $T
    if [ "$1" = logs ]; then        # plus what the rescue system itself knows
        dmesg > $T/rescue-kernel.log 2>/dev/null
        status > $T/board-status.txt 2>/dev/null; health >> $T/board-status.txt 2>/dev/null
        cp $RUN/nocry-check.log $T/ 2>/dev/null
        data_on ro || exit 1        # health unmounted it
    fi
    # one archive: the board's files under data/, the rescue system's own notes beside them
    if [ -n "$have" ]; then ( cd $DATA && tar cf - $have 2>/dev/null ) | ( cd $T && mkdir -p data && cd data && tar xf - 2>/dev/null ); fi
    ( cd $T && tar cf - . 2>/dev/null ) | gzip      # this tar has no compression of its own
    rm -rf $T; data_off
}

# The network the board is on, into the settings of the installed firmware, so the printer
# joins it by itself at its next normal start (a board whose screen cannot be used).
wifi_save() {
    [ -s $RUN/nocry-sta.conf ] || { echo "not connected to a network configured in rescue" >&2; exit 1; }
    data_on rw || exit 1
    if [ -d $DATA/nebulaos ]; then f=$DATA/nebulaos/network/wpa_supplicant.conf; else f=$DATA/wpa_supplicant.conf; fi
    mkdir -p "$(dirname "$f")"
    {
        # the firmware's own first lines if it has any, else what both firmwares write themselves
        if [ -f "$f" ]; then awk '/^[ \t]*network=\{/ { exit } { print }' "$f"; else printf 'ctrl_interface=/var/run/wpa_supplicant\nupdate_config=1\n'; fi
        awk '/^[ \t]*network=\{/ { on = 1 } on { print } on && /^[ \t]*\}/ { on = 0 }' $RUN/nocry-sta.conf | grep -v 'scan_ssid'
    } > "$f.new" && mv "$f.new" "$f" && chmod 600 "$f"
    rc=$?; data_off
    [ $rc = 0 ] && echo "saved for ${f#$DATA/}"
    exit $rc
}

# The board has no clock that keeps time, and a download over https checks the server's
# certificate against the date. Set it once from the network (it is only ever used for that).
clock() {
    [ "$(date +%Y)" -ge 2025 ] && return 0
    # the Date line of any web server's answer is close enough (plain http: no certificate needed yet)
    # (pages made for exactly this kind of question: they answer over plain http and carry a date)
    d=
    for u in http://example.com/ http://detectportal.firefox.com/success.txt http://neverssl.com/; do
        d=$(wget -q -S -T 6 -O /dev/null $u 2>&1 | sed -n 's/^ *[Dd]ate: *[A-Za-z]*, *//p' | head -1 | tr -d '\r')
        [ -n "$d" ] && break
    done
    set -- $d       # 27 Nov 2026 10:11:12 GMT
    case "$2" in Jan) m=01 ;; Feb) m=02 ;; Mar) m=03 ;; Apr) m=04 ;; May) m=05 ;; Jun) m=06 ;; Jul) m=07 ;; Aug) m=08 ;; Sep) m=09 ;; Oct) m=10 ;; Nov) m=11 ;; Dec) m=12 ;; *) return 1 ;; esac
    date -u -s "$3-$m-$1 $4" >/dev/null 2>&1
    [ "$(date +%Y)" -ge 2025 ]
}

# --- nocry itself on the board: the same program and checks as on a computer --------------
# It works on the board's own storage, unpacks into files instead of memory (the staging
# folder) and keeps its downloads on the data partition, which has the room.
WORKDIR=$DATA/.nocry-rescue
nocry_env() {
    export NOCRY_BOARD_DISK=$DISK NOCRY_IMAGES=/usr/share/nocry/images
    export XDG_DATA_HOME=$WORKDIR/data NOCRY_STAGE_DIR=$WORKDIR/stage HOME=$WORKDIR
}
# start an install session: the data partition mounted read-write with room to work in
session_on() {
    [ -x /usr/sbin/nocry ] || { echo "this rescue image has no installer (nocry is missing)" >&2; return 1; }
    if [ ! -d $SESSION ]; then
        p=$(part userdata) || { echo "no userdata partition" >&2; return 1; }
        mkdir -p $DATA; grep -q " $DATA " /proc/mounts && umount $DATA 2>/dev/null
        made=
        if [ "$(dd if="$p" bs=1 skip=1080 count=2 2>/dev/null | hexdump -v -e '/1 "%02x"')" != 53ef ]; then
            # blank (after a reset): a file system of our own to work in, removed again afterwards
            # so the firmware finds the partition blank and makes its own
            mke2fs -F -q -t ext4 "$p" >/dev/null 2>&1 || { echo "userdata is blank and mke2fs failed" >&2; return 1; }
            made=1
        fi
        mount -t ext4 -o rw "$p" $DATA 2>/dev/null || { echo "userdata cannot be mounted (damaged? run fsck)" >&2; return 1; }
        mkdir -p $SESSION; [ -n "$made" ] && : > $SESSION/made-fs
    fi
    rm -rf $WORKDIR/stage; mkdir -p $WORKDIR/stage $WORKDIR/data
    nocry_env
}
session_off() {
    rm -rf $WORKDIR
    sync; grep -q " $DATA " /proc/mounts && umount $DATA 2>/dev/null
    if [ -e $SESSION/made-fs ]; then ok "nocry-zero:userdata:0:100000" >/dev/null; fi      # back to blank
    rm -rf $SESSION
}

# Runs nocry with the job's progress taken from what it prints; stops it politely on Cancel.
# nocry_job LOGFILE ARGS...
nocry_job() {
    log=$1; shift
    /usr/sbin/nocry "$@" > "$log" 2>&1 &
    np=$!
    while kill -0 $np 2>/dev/null; do
        [ -e $STOP ] && kill -TERM $np 2>/dev/null
        last=$(tr '\r' '\n' < "$log" | tail -1 | sed 's/^ *//; s/ *$//')
        [ -n "$last" ] || last=$IDLE        # nothing said yet: what this phase starts with
        # "<what>:  12/110 MiB ..." or "... 12.0 MB of 110.0 MB"
        set -- $(echo "$last" | sed -n 's/.* \([0-9][0-9]*\)\/\([0-9][0-9]*\) MiB.*/\1 \2/p')
        if [ -n "$2" ]; then DONE=$(( $1 << 20 )); TOTAL=$(( $2 << 20 )); fi
        job_state running "$what" "$DONE" "$TOTAL" "$(echo "$last" | cut -c1-90)"
        sleep 1
    done
    wait $np
}
last_line() { tr '\r' '\n' < "$1" | grep -v '^ *$' | tail -1 | sed 's/^ *//; s/^Error: //' | cut -c1-300; }

# download (or take the uploaded file), then work out what installing it would do
do_fw_fetch() {     # do_fw_fetch list KEY VERSION MODE | do_fw_fetch file NAME MODE
    TOTAL=1; DONE=0
    if [ "$1" = list ]; then
        mode=$4
        nocry_job $RUN/nocry-fetch.log fetch "$2" "$3" || { MSG=$(last_line $RUN/nocry-fetch.log); return 1; }
        file=$(tail -1 $RUN/nocry-fetch.log)
    else
        mode=$3; file=$WORKDIR/$2
    fi
    [ -f "$file" ] || { MSG="firmware file missing"; return 1; }
    echo "$file" > $SESSION/file; echo "$mode" > $SESSION/mode; rm -f $SESSION/report
    if [ "$mode" = slot ]; then set -- --other-slot; else set --; fi
    what="Verifying firmware"
    DONE=0; TOTAL=1; IDLE="unpacking image"     # not the download's numbers any more
    nocry_job $RUN/nocry-plan.log install "$file" --report "$@" || { MSG=$(last_line $RUN/nocry-plan.log); rm -f "$file"; return 1; }
    # the serial number and network address stay off the pages
    grep '^[a-z_]*=' $RUN/nocry-plan.log | grep -v '^note=sn_mac' > $SESSION/report
    MSG="verified; nothing written yet"
}

do_fw_install() {
    file=$(cat $SESSION/file 2>/dev/null); mode=$(cat $SESSION/mode 2>/dev/null)
    [ -f "$file" ] || { MSG="no verified firmware pending"; return 1; }
    if [ "$mode" = slot ]; then set -- --other-slot; else set --; fi
    TOTAL=$(sed -n 's/^to_write=//p' $SESSION/report); TOTAL=${TOTAL:-1}; DONE=0; IDLE="unpacking image"
    nocry_job $RUN/nocry-install.log install "$file" --yes "$@" || { MSG=$(last_line $RUN/nocry-install.log); return 1; }
    MSG=$(last_line $RUN/nocry-install.log)
    session_off
}

# --- the rescue system stored on the board (docs/nocryboot.md) ---------------------------
# A file on the data partition, and in the third sector of "ota" a note for the loader saying
# where the file's blocks are and what they sum to. Hold the screen at power-on and the
# nocryboot loader (0.2 or later, Nebula Pad) starts it.
RESCUE_DIR=nocry-rescue
RESCUE_FILE=$RESCUE_DIR/rescue.uImage
ota_note() { p=$(part ota) || return 1; dd if="$p" bs=512 skip=2 count=1 2>/dev/null | tr -d '\000' | head -1; }
rescue_status() {
    note=$(ota_note)
    case "$note" in
      nocryboot:rescue:*)
        if echo "$note" | nocry-extent --check "$DISK"; then echo "stored=yes"; else echo "stored=damaged"; fi ;;
      *) echo "stored=no" ;;
    esac
    if data_on ro 2>/dev/null; then
        [ -f "$DATA/$RESCUE_FILE" ] && echo "file_bytes=$(ls -l "$DATA/$RESCUE_FILE" | awk '{print $5}')"
        data_off
    fi
}
rescue_install() {
    [ -d $LOCK ] && { echo "another job is still running" >&2; return 1; }
    [ -d $SESSION ] && { echo "a firmware install is pending; finish or discard it first" >&2; return 1; }
    o=$(part ota) || { echo "this board has no ota partition" >&2; return 1; }
    u=$(part userdata) || { echo "no userdata partition" >&2; return 1; }
    data_on rw || return 1
    mkdir -p "$DATA/$RESCUE_DIR"
    # take the old note away first: from here until the new one is written and checked, the
    # loader finds nothing and starts the firmware
    dd if=/dev/zero of="$o" bs=512 seek=2 count=1 conv=notrunc 2>/dev/null
    rm -f "$DATA/$RESCUE_FILE"
    cat > "$DATA/$RESCUE_FILE" || { data_off; echo "could not write the image (userdata full?)" >&2; return 1; }
    sync
    # what the loader will insist on: a kernel image named for it, needing no unpacking
    if [ "$(dd if="$DATA/$RESCUE_FILE" bs=1 count=4 2>/dev/null | hexdump -v -e '/1 "%02x"')" != 27051956 ] ||
       [ "$(dd if="$DATA/$RESCUE_FILE" bs=1 skip=32 count=12 2>/dev/null)" != nocry-rescue ]; then
        rm -f "$DATA/$RESCUE_FILE"; data_off; echo "that is not a nocry rescue image" >&2; return 1
    fi
    note=$(nocry-extent "$DATA/$RESCUE_FILE" "$(cat /sys/class/block/$(basename "$u")/start)") || { data_off; return 1; }
    data_off        # everything on the disk before it is read back raw
    echo "$note" | nocry-extent --check "$DISK" || { echo "read-back checksum mismatch; the loader record was not written" >&2; return 1; }
    { printf '%s\n' "$note"; dd if=/dev/zero bs=512 count=1 2>/dev/null; } | dd of="$o" bs=512 seek=2 count=1 conv=notrunc 2>/dev/null
    sync
    [ "$(ota_note)" = "$note" ] || { echo "could not write the loader record" >&2; return 1; }
    echo "stored=yes"
    echo "pieces=$(echo "$note" | tr ' ' '\n' | grep -c '+')"
}
rescue_remove() {
    [ -d $LOCK ] && { echo "another job is still running" >&2; return 1; }
    o=$(part ota) && dd if=/dev/zero of="$o" bs=512 seek=2 count=1 conv=notrunc 2>/dev/null
    if data_on rw 2>/dev/null; then rm -rf "$DATA/$RESCUE_DIR"; data_off; fi
    sync; echo "stored=no"
}

case "$1" in
  status) status ;;
  health) health ;;
  rescue-status) rescue_status ;;
  rescue-install) rescue_install ;;
  rescue-remove) rescue_remove ;;
  fw-list)
    # the list lives in memory between requests; "refresh" asks the internet for the current one
    export XDG_DATA_HOME=$RUN/nocry-list HOME=$RUN/nocry-list; mkdir -p $XDG_DATA_HOME
    [ -x /usr/sbin/nocry ] || exit 1
    if [ "$2" = refresh ]; then clock; /usr/sbin/nocry catalog --refresh >/dev/null 2>$RUN/nocry-list.err || { tail -1 $RUN/nocry-list.err | sed 's/^Error: //' >&2; exit 1; }; fi
    # for this board: its own printer type, and NebulaOS where that is made for it
    model=$(status | sed -n 's/^model=//p')
    case "$model" in "Nebula Pad") key=NEBULA ;; *) key=$model ;; esac
    /usr/sbin/nocry catalog --tsv 2>/dev/null | awk -F '\t' -v k="$key" '$1 == k || ($1 == "NEBULAOS" && (k == "F005" || k == "NEBULA"))' ;;
  fw-fetch)
    case "$4" in keep|slot) ;; *) echo "usage: nocry-rescue-do fw-fetch KEY VERSION keep|slot" >&2; exit 2 ;; esac
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    session_on || exit 1
    mkdir -p $WORKDIR/data/nocry; cp $RUN/nocry-list/nocry/catalog.json $WORKDIR/data/nocry/ 2>/dev/null   # the list the page showed
    clock
    RISK="Download and verification only: nothing on the board has been changed."
    run_job "Downloading firmware" do_fw_fetch list "$2" "$3" "$4" ;;
  fw-upload-path)
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    session_on || exit 1
    echo "$WORKDIR/upload.bin" ;;
  fw-check)
    case "$3" in keep|slot) ;; *) echo "usage: nocry-rescue-do fw-check NAME keep|slot" >&2; exit 2 ;; esac
    [ -d $SESSION ] || { echo "no upload pending" >&2; exit 1; }
    nocry_env
    # nocry tells the kinds of firmware file apart by their contents, and one kind by its name
    n=$(echo "$2" | tr -cd 'A-Za-z0-9._-'); [ -n "$n" ] || n=firmware.img
    mv $WORKDIR/upload.bin "$WORKDIR/$n" 2>/dev/null || { echo "upload missing" >&2; exit 1; }
    RISK="Verification only: nothing on the board has been changed."
    run_job "Verifying firmware" do_fw_fetch file "$n" "$3" ;;
  fw-report) cat $SESSION/report 2>/dev/null; [ -f $SESSION/mode ] && echo "mode=$(cat $SESSION/mode)" ;;
  fw-install)
    [ -s $SESSION/report ] || { echo "no verified firmware pending" >&2; exit 1; }
    nocry_env
    if [ "$(cat $SESSION/mode)" = slot ]; then
        RISK="The target slot is left incomplete and cannot boot until the install is run again. The active slot is not affected."
    else
        RISK="The active slot is being overwritten and is incomplete. If cancelled, the board will not boot until the install is run again to completion; rescue can do that."
    fi
    run_job "Installing firmware" do_fw_install ;;
  fw-discard)
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    [ -d $SESSION ] && session_off ;;
  loader|logo)
    [ -x /usr/sbin/nocry ] || { echo "this rescue image has no installer (nocry is missing)" >&2; exit 1; }
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    export NOCRY_BOARD_DISK=$DISK NOCRY_IMAGES=/usr/share/nocry/images HOME=$RUN/nocry-list XDG_DATA_HOME=$RUN/nocry-list
    mkdir -p $HOME
    case "$1 $2" in
      "loader ") /usr/sbin/nocry loader 2>&1 ;;
      "loader install") /usr/sbin/nocry loader --install --yes 2>&1 ;;
      "loader factory") /usr/sbin/nocry loader --factory --yes 2>&1 ;;
      "logo ") /usr/sbin/nocry logo 2>&1 ;;
      "logo nocry") /usr/sbin/nocry logo --nocry --yes 2>&1 ;;
      "logo firmware") /usr/sbin/nocry logo --firmware --yes 2>&1 ;;
      *) echo "usage: nocry-rescue-do loader [install|factory] | logo [nocry|firmware]" >&2; exit 2 ;;
    esac ;;
  check)
    case "$2" in data) n=userdata; t="userdata (fsck)" ;; settings) n=rootfs_data; t="rootfs_data (fsck)" ;; *) echo "usage: nocry-rescue-do check data|settings" >&2; exit 2 ;; esac
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    [ -d $SESSION ] && session_off      # a firmware file held for installing: let it go, the partition must be free
    grep -q " $DATA " /proc/mounts && umount $DATA 2>/dev/null
    NOSTOP=1        # e2fsck is not interrupted
    RISK="An interrupted repair can leave the file system in a worse state. Let it finish."
    run_job "Checking $t" do_check $n ;;
  ls)
    inside "${2:-/}" || exit 1; data_on ro || exit 1
    [ -d "$P" ] || { data_off; echo "no such folder" >&2; exit 1; }
    ls -lA "$P" 2>/dev/null | awk 'NR > 1 || $1 !~ /^total/ { t = substr($1, 1, 1); if (t != "d" && t != "-") next; n = $9; for (i = 10; i <= NF; i++) n = n " " $i; printf "%s\t%s\t%s\n", (t == "d" ? "d" : "f"), $5, n }'
    data_off ;;
  get)
    inside "$2" || exit 1; data_on ro || exit 1
    if [ -f "$P" ] && [ ! -L "$P" ]; then cat "$P"; rc=$?; else echo "no such file" >&2; rc=1; fi
    data_off; exit $rc ;;
  put)
    inside "$2" || exit 1; data_on rw || exit 1
    if [ -d "$(dirname "$P")" ] && [ ! -d "$P" ] && [ ! -L "$P" ]; then cat > "$P.nocry-new" && mv "$P.nocry-new" "$P"; rc=$?; else echo "no such folder" >&2; rc=1; fi
    data_off; exit $rc ;;
  rm)
    inside "$2" || exit 1; [ "$P" != "$DATA/" ] || exit 1; data_on rw || exit 1
    if [ -d "$P" ] && [ ! -L "$P" ]; then rmdir "$P" 2>/dev/null || { echo "the folder is not empty" >&2; false; }; else rm -f "$P"; fi; rc=$?
    data_off; exit $rc ;;
  bundle) bundle "$2" ;;
  wifi-save) wifi_save ;;
  restart)
    [ -d $LOCK ] && { echo "a job is running; cancel it or let it finish first" >&2; exit 1; }
    sync; ( sleep 2; reboot -f ) </dev/null >/dev/null 2>&1 & ;;
  switch)
    case "$2" in a|b) ;; *) echo "slot must be a or b" >&2; exit 2 ;; esac
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    slot "$2" | grep -q "^$2_complete=yes" || { echo "slot $2 has no complete firmware; it would not boot" >&2; exit 1; }
    r=$(ok "set_active:$2") || { echo "$r" >&2; exit 1; } ;;
  copy)
    case "$2" in a|b) ;; *) echo "slot must be a or b" >&2; exit 2 ;; esac
    slot "$2" | grep -q "^$2_complete=yes" || { echo "slot $2 has no complete firmware to copy" >&2; exit 1; }
    if [ "$2" = a ]; then o=B; else o=A; fi
    RISK="Slot $o is left incomplete and cannot boot until the copy is run again."
    run_job "Copying slot $(echo "$2" | tr ab AB) to slot $o" do_copy "$2" ;;
  reset)
    [ -d $LOCK ] && { echo "another job is still running" >&2; exit 1; }
    [ -d $SESSION ] && session_off      # the data partition must not be mounted while it is erased
    case "$2" in
      mods) RISK="rootfs_data is left partly erased. The firmware may not boot correctly until the wipe is run to completion."
            run_job "Wiping system overlay" do_reset mods ;;
      all)  RISK="rootfs_data and userdata are left partly erased; erased data is not recoverable. The firmware may not boot correctly until the reset is run to completion."
            run_job "Factory reset" do_reset all ;;
      *) echo "usage: nocry-rescue-do reset mods|all" >&2; exit 2 ;;
    esac ;;
  job) cat $JOB 2>/dev/null || echo "state=none" ;;
  cancel) [ -d $LOCK ] && : > $STOP ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
