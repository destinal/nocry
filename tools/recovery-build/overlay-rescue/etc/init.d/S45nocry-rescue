#!/bin/sh
# nocry-rescue: get the board onto a network, start the service nocry on a computer talks to,
# the web pages and the touch interface (nocry-ui).
#
# Network (all of it in /usr/sbin/nocry-wifi):
#   1. the Wi-Fi network the installed firmware has saved, if there is one and it is in reach;
#   2. otherwise the board's own network "nocry" (WPA2, password "nocry111"),
#      board at 192.168.77.1.
# Either way the board serves web pages (nocry-webd) at its address: Wi-Fi, slots, resets.
# The own network's password only gets a device onto that network. Driving the board, or
# changing its network, needs the pairing code on the screen, which changes at every start
# and after three wrong tries.

CODE=/run/nocry-pair-code
STATE=/run/nocry-wifi.state

val() { sed -n "s/^$1=//p" $STATE 2>/dev/null; }

# Text on the screen, turned as the owner turned the touch interface (kept with the touch
# calibration; without a kept turn the panel is used as it is, wide). An upright screen is
# narrow: the name takes two lines there.
ban() {
    case "$NOCRY_TURN" in
      90|270) nocry-banner "#nocry" "#rescue" "" "$@" ;;
      *) nocry-banner "#nocry rescue" "" "$@" ;;
    esac
}

show() {
    c=$(cat $CODE 2>/dev/null); code="#${c%???} ${c#???}"
    case "$(val mode)" in
      ap)
        ban \
            "Wi-Fi network  $(val ssid)" "$(p=$(val password); [ -n "$p" ] && echo "password  $p" || echo "open network (no password)")" \
            "then open" "http://$(val address)" "" "pairing code" "$code" ;;
      client)
        ban \
            "on Wi-Fi  $(val ssid)" "open" "http://$(val address)" "" "pairing code" "$code" ;;
      joining)
        ban "joining Wi-Fi  $(val ssid)" "" "one moment..." ;;
      off)
        ban "Wi-Fi off" "connect by USB" ;;
      none)
        ban "no Wi-Fi found" "connect by USB" "" "pairing code" "$code" ;;
      *)
        ban "starting..." ;;
    esac
}

# Started by holding the screen at power-on: the loader has already made sure of the touch
# (three readings over 40 ms, all pressed), so nothing more is asked of the finger here. A
# count that had to be held through was tried first; stray touches turned out not to happen.

start() {
    mkdir -p /run /var/run/wpa_supplicant
    # the kept settings first: which way up everything is drawn
    nocry-rescue-do cal-get > /run/nocry-touch.cal 2>/dev/null || rm -f /run/nocry-touch.cal
    NOCRY_TURN=$(sed -n 's/^turn //p' /run/nocry-touch.cal 2>/dev/null | head -1); export NOCRY_TURN=${NOCRY_TURN:-0}
    # USB: a computer on the Micro-USB socket, or a flash drive in an A socket (nocry-usb)
    setsid nocry-usb daemon >/dev/null 2>&1 </dev/null &
    # one copy of the rescue system good and the other gone (a slot was rewritten whole): put it back
    ( r=$(nocry-rescue-do rescue-heal 2>&1); case "$r" in *healed=[ab]*|*failed*) echo "nocry-rescue: copies: $r" > /dev/kmsg ;; esac ) &
    show
    # what the owner turned on for reaching the board over the network (nocry on a computer,
    # adb, SSH: all off otherwise), and a pairing code for the web pages either way
    nocry-remote apply
    # the web pages, on whatever network the board is on (in a session of their own)
    setsid nocry-webd >/dev/null 2>/dev/console </dev/null &
    nocry-wifi auto >/dev/null 2>&1 &
    # The touch interface. Without the program (or a screen it can use) the plain text screen
    # stays, kept in step with the network and the pairing code.
    ( while [ -x /usr/sbin/nocry-ui ]; do
          nocry-ui 2>/dev/console; [ $? = 1 ] && break     # 1: no usable screen; anything else: start it again
          sleep 1
      done
      last=; while :; do
          now="$(cat $CODE 2>/dev/null)|$(cat $STATE 2>/dev/null)"
          [ "$now" != "$last" ] && { last=$now; show; }
          sleep 1
      done ) &
}

case "$1" in
  start) start ;;
  stop) killall nocry-usb nocry-ui nocry-netd nocry-relay dropbear nocry-webd wpa_supplicant dnsmasq mdnsd udhcpc 2>/dev/null ;;
esac
exit 0
