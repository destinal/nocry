#!/bin/sh
# nocry-rescue, until the touch interface exists: get the board onto a network, start the
# service nocry on a computer talks to, and show on the screen how to reach it.
#
# Network (all of it in /usr/sbin/nocry-wifi):
#   1. the Wi-Fi network the installed firmware has saved, if there is one and it is in reach;
#   2. otherwise the board's own network "nocry" (WPA2, password "nocry111"),
#      board at 192.168.77.1.
# Either way the board serves web pages (nocry-webd) at its address: Wi-Fi, slots, resets.
# The own network's password only gets a device onto that network. Driving the board, or
# changing its network, needs the pairing code on the screen, which changes at every start
# and after three wrong tries.

CODE=/run/nocry-pair-code
STATE=/run/nocry-wifi.state

val() { sed -n "s/^$1=//p" $STATE 2>/dev/null; }

show() {
    c=$(cat $CODE 2>/dev/null); code="#${c%???} ${c#???}"
    case "$(val mode)" in
      ap)
        nocry-banner "#nocry-rescue" "" \
            "Wi-Fi network   $(val ssid)" "password        $(val password)" \
            "then open       http://$(val address)" "" "pairing code" "$code" ;;
      client)
        nocry-banner "#nocry-rescue" "" \
            "on Wi-Fi        $(val ssid)" "open            http://$(val address)" "" "pairing code" "$code" ;;
      joining)
        nocry-banner "#nocry-rescue" "" "joining Wi-Fi   $(val ssid)" "" "one moment..." ;;
      none)
        nocry-banner "#nocry-rescue" "" "no Wi-Fi found" "connect by USB" "" "pairing code" "$code" ;;
      *)
        nocry-banner "#nocry-rescue" "" "starting..." ;;
    esac
}

# Started by holding the screen at power-on (the loader says so): the screen has to stay held
# for five more seconds, with a count on it, or the board restarts into its firmware. A stray
# touch while switching on then costs a restart and nothing else.
confirm_hold() {
    grep -q 'nocry.rescue=touch' /proc/cmdline || return 0
    n=5
    while [ $n -gt 0 ]; do
        nocry-banner "#nocry rescue" "" "Keep holding the screen" "to start the rescue system" "" "#$n"
        i=0
        while [ $i -lt 4 ]; do
            nocry-touch --held; r=$?
            # let go: back to the firmware. A chip that does not answer is not a reason to leave.
            if [ $r = 1 ]; then
                nocry-banner "#nocry rescue" "" "Starting the printer" "normally..."
                sync; reboot -f; sleep 30
            fi
            sleep 0.25; i=$((i+1))
        done
        n=$((n-1))
    done
    nocry-banner "#nocry rescue" "" "You can let go."
    sleep 1
}

start() {
    mkdir -p /run /var/run/wpa_supplicant
    confirm_hold
    show
    nocry-netd --code-file $CODE 2>/dev/console &
    # the web pages, on whatever network the board is on (in a session of their own)
    setsid nocry-webd >/dev/null 2>/dev/console </dev/null &
    nocry-wifi auto >/dev/null 2>&1 &
    # keep the screen in step with the network and the pairing code
    ( last=; while :; do
          now="$(cat $CODE 2>/dev/null)|$(cat $STATE 2>/dev/null)"
          [ "$now" != "$last" ] && { last=$now; show; }
          sleep 1
      done ) &
}

case "$1" in
  start) start ;;
  stop) killall nocry-netd nocry-webd wpa_supplicant dnsmasq mdnsd udhcpc 2>/dev/null ;;
esac
exit 0
