#!/bin/sh
# nocry-wifi: the rescue system's Wi-Fi, in one place (docs/nocry-rescue.md).
#
#   nocry-wifi auto                 at start: join the network the installed firmware saved,
#                                   else open the board's own network
#   nocry-wifi ap                   open the board's own network: "nocry" with the password
#                                   "nocry111", or the name and password the owner set on the
#                                   touch screen (kept with its settings; no password = open)
#   nocry-wifi join SSID [PASSWORD] join a network; back to the own network if that fails
#   nocry-wifi join SSID PASSWORD static ADDRESS MASK [GATEWAY [DNS]]
#                                   the same with a fixed address instead of asking the network
#                                   for one (PASSWORD "" for an open network; "" skips a field)
#   nocry-wifi wps                  join the router whose WPS button was just pressed (push-button
#                                   WPS, two minutes); back to the own network if that fails
#   nocry-wifi wps-cancel           stop waiting for the router's WPS button (exit status 3 there)
#   nocry-wifi off                  leave the network and keep the radio off (until a network is
#                                   chosen, the own network is opened, or the board restarts)
#   nocry-wifi rejoin               join the last network again
#   nocry-wifi scan                 networks in range, strongest first: "signal<TAB>lock<TAB>name"
#   nocry-wifi status               mode=ap|client|off|none, ssid=, address=, source=, addressing=dhcp|static
#   nocry-wifi saved                where a saved network was found, and its names
#
# The board has one radio: it is either its own access point or a client, never both. The own
# network is the fallback for everything, so a wrong password cannot lock anyone out.
# State for the screen and the web page is in /run/nocry-wifi.state; a password is only ever
# written to /run (memory) and to nothing that survives a restart.

IF=wlan0
# Short on purpose: they are typed on a phone. WPA2 does not take a password under 8 characters.
# It only gets a device onto this network; see the pairing code.
AP_SSID=nocry
AP_PASS=nocry111
AP_ADDR=192.168.77.1
RUN=/run
STATE=$RUN/nocry-wifi.state
CTRL=/var/run/wpa_supplicant
LOCK=$RUN/nocry-wifi.lock

# What happened, for whoever has to find out why a join failed: $RUN/nocry-wifi.log (never a
# password; only how long it was) and, for the last attempt, wpa_supplicant's own log.
log() {
    echo "nocry-wifi: $*" > /dev/console 2>/dev/null; echo "nocry-wifi: $*" >&2
    echo "$(cut -d' ' -f1 /proc/uptime) $*" >> $RUN/nocry-wifi.log
}

HINT=; ADDRESSING=
state() {   # state MODE SSID ADDRESS SOURCE
    pw=; [ "$1" = ap ] && pw=$AP_PASS      # the own network's password is public and shown on the screen
    printf 'mode=%s\nssid=%s\naddress=%s\nsource=%s\nhint=%s\npassword=%s\naddressing=%s\n' "$1" "$2" "$3" "$4" "$HINT" "$pw" "$ADDRESSING" > $STATE.new && mv $STATE.new $STATE
}

# A fixed address for the network being joined, for networks without a DHCP server: kept in
# $RUN/nocry-sta.static (address, mask, gateway, DNS: one line each) beside the network itself.
STATIC=$RUN/nocry-sta.static
quad() {    # is $1 four numbers 0-255 with dots?
    echo "$1" | awk -F. 'NF != 4 { exit 1 } { for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i > 255) exit 1 }'
}
prefix() {  # 255.255.255.0 -> 24; nothing for a mask with holes
    echo "$1" | awk -F. '{ n = 0; done = 0
        for (i = 1; i <= 4; i++) { v = $i; for (b = 128; b >= 1; b /= 2) { if (v >= b) { if (done) exit 1; n++; v -= b } else done = 1 } }
        print n }'
}

part() {    # device of the partition named $1
    for u in /sys/class/block/mmcblk0p*/uevent; do
        grep -q "^PARTNAME=$1\$" "$u" 2>/dev/null && { echo "/dev/$(basename "$(dirname "$u")")"; return 0; }
    done
    return 1
}

# The address the printer's own firmware uses for Wi-Fi is the one in its identity record, so a
# router sees the same device in rescue as in normal use.
set_mac() {
    p=$(part sn_mac) || return 0
    mac=$(dd if="$p" bs=512 count=1 2>/dev/null | tr -d '\000' | cut -d';' -f2 | tr 'A-F' 'a-f')
    case "$mac" in
        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
        *) return 0 ;;
    esac
    m=$(echo "$mac" | sed 's/../&:/g; s/:$//')
    [ "$(cat /sys/class/net/$IF/address 2>/dev/null)" = "$m" ] && return 0
    ip link set $IF down 2>/dev/null
    ip link set $IF address "$m" 2>/dev/null || log "could not set the Wi-Fi address"
}

radio_down() {
    killall -q udhcpc dnsmasq 2>/dev/null
    wpa_cli -p $CTRL -i $IF terminate >/dev/null 2>&1
    i=0; while pidof wpa_supplicant >/dev/null && [ $i -lt 20 ]; do sleep 0.2; i=$((i+1)); done
    killall -q wpa_supplicant 2>/dev/null
    ip addr flush dev $IF 2>/dev/null
    ip link set $IF down 2>/dev/null
}

announce() { killall -q mdnsd 2>/dev/null; mdnsd 2>/dev/null; }

do_scan() {
    # the radio has to be up; in access-point mode this chip may refuse to scan, then the list
    # taken before the access point was opened is used
    ip link set $IF up 2>/dev/null
    iw dev $IF scan 2>/dev/null | awk '
        function flush() { if (ssid != "") print sig "\t" (lock ? "lock" : "open") "\t" ssid }
        /^BSS / { flush(); ssid = ""; sig = -100; lock = 0 }
        /^\tsignal:/ { sig = int($2) }
        /^\tSSID: / { ssid = substr($0, 8) }
        /^\tRSN:|^\tWPA:/ { lock = 1 }
        /capability:.*Privacy/ { lock = 1 }
        END { flush() }' | sort -t "$(printf '\t')" -k3,3 -k1,1nr | awk -F '\t' '!seen[$3]++' | sort -t "$(printf '\t')" -k1,1nr > $RUN/nocry-scan.new
    if [ -s $RUN/nocry-scan.new ]; then mv $RUN/nocry-scan.new $RUN/nocry-scan; else rm -f $RUN/nocry-scan.new; fi
    cat $RUN/nocry-scan 2>/dev/null
}

# the owner's own name and password for the board's network, if set (nocry-ui keeps them in
# its settings: "ap_ssid NAME" and "ap_pass PASSWORD" lines; an empty password = an open network)
ap_settings() {
    f=$RUN/nocry-touch.cal
    n=$(sed -n 's/^ap_ssid //p' $f 2>/dev/null | head -1)
    [ -n "$n" ] || return 0
    AP_SSID=$n
    p=$(sed -n 's/^ap_pass //p' $f 2>/dev/null | head -1)
    case "$p" in *'"'*) return 0 ;; esac
    if [ ${#p} -eq 0 ] || { [ ${#p} -ge 8 ] && [ ${#p} -le 63 ]; }; then AP_PASS=$p; fi
}

start_ap() {
    ap_settings
    radio_down
    set_mac
    [ -e /sys/class/net/$IF ] || { state none "" "" ""; return 1; }
    [ -s $RUN/nocry-scan ] || do_scan >/dev/null     # while the radio is still free to scan
    cat > $RUN/nocry-ap.conf <<CONF
ctrl_interface=$CTRL
network={
    ssid=$(hex "$AP_SSID")
    mode=2
    frequency=2437
$(if [ -n "$AP_PASS" ]; then printf '    key_mgmt=WPA-PSK\n    proto=RSN\n    pairwise=CCMP\n    psk="%s"\n' "$AP_PASS"; else echo "    key_mgmt=NONE"; fi)
}
CONF
    wpa_supplicant -B -i $IF -D nl80211 -c $RUN/nocry-ap.conf >/dev/null 2>&1
    ip addr add $AP_ADDR/24 dev $IF 2>/dev/null
    ip link set $IF up
    # every name resolves to the board, so a phone that joins is shown the board's pages (nocry-webd) by itself
    dnsmasq --interface=$IF --bind-interfaces --dhcp-range=192.168.77.10,192.168.77.50,12h \
        --dhcp-leasefile=$RUN/nocry-leases --pid-file=$RUN/nocry-dnsmasq.pid --address=/#/$AP_ADDR
    state ap "$AP_SSID" "$AP_ADDR" "$1"
    announce
    log "own network $AP_SSID open at $AP_ADDR"
}

# join_conf FILE NAME SOURCE: FILE is a complete wpa_supplicant configuration
join_conf() {
    radio_down
    set_mac
    state joining "$2" "" "$3"
    rm -f $RUN/nocry-wpa.log
    wpa_supplicant -B -i $IF -D nl80211 -c "$1" -d -f $RUN/nocry-wpa.log >/dev/null 2>&1 || { log "wpa_supplicant did not start"; return 1; }
    i=0; seen=
    while [ $i -lt 30 ]; do
        s=$(wpa_cli -p $CTRL -i $IF status 2>/dev/null | sed -n 's/^wpa_state=//p')
        case " $seen " in *" $s "*) ;; *) seen="$seen $s" ;; esac
        [ "$s" = COMPLETED ] && break
        sleep 1; i=$((i+1))
    done
    if [ "$s" != COMPLETED ]; then
        # how far it got says what went wrong
        if ! grep -q "selected BSS" $RUN/nocry-wpa.log 2>/dev/null; then why="the network was not seen (out of range, or not a 2.4 GHz network)"
        elif grep -q "WRONG_KEY\|4-Way Handshake failed\|pre-shared key may be incorrect" $RUN/nocry-wpa.log; then why="the network refused the password"
        elif grep -q "CTRL-EVENT-ASSOC-REJECT" $RUN/nocry-wpa.log; then why="the network turned the board away (with this Wi-Fi chip that is what a wrong password looks like)"
        else why="no answer from the network"; fi
        log "could not join $2: $why; states:$seen; $(grep -c CTRL-EVENT-ASSOC-REJECT $RUN/nocry-wpa.log 2>/dev/null) rejections"
        return 1
    fi
    got_network "$2" "$3"
}

# joined: now an address (the network's, or the fixed one), and say so. got_network NAME SOURCE
got_network() {
    ssid=$(wpa_cli -p $CTRL -i $IF status 2>/dev/null | sed -n 's/^ssid=//p')
    if [ -s $STATIC ]; then
        { read -r s_addr; read -r s_mask; read -r s_gw; read -r s_dns; } < $STATIC
        ip addr flush dev $IF 2>/dev/null
        ip addr add "$s_addr/$(prefix "$s_mask")" dev $IF 2>/dev/null || { log "joined $ssid but could not set the address $s_addr"; return 1; }
        if [ -n "$s_gw" ]; then ip route replace default via "$s_gw" dev $IF 2>/dev/null || log "the gateway $s_gw is not in the address's network; no route beyond it"; fi
        [ -n "$s_dns" ] && echo "nameserver $s_dns" > /etc/resolv.conf
        ADDRESSING=static
    else
        udhcpc -i $IF -n -q -t 8 -T 2 >/dev/null 2>&1 || { log "joined $ssid but got no address from it (no DHCP server? a fixed address can be set)"; return 1; }
        udhcpc -i $IF -b -S >/dev/null 2>&1     # keep the lease alive
        ADDRESSING=dhcp
    fi
    addr=$(ip -4 addr show dev $IF | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
    [ -n "$addr" ] || return 1
    state client "${ssid:-$1}" "$addr" "$2"
    announce
    log "joined ${ssid:-$1}, address $addr"
}

# Push-button WPS: the router hands over its name and password after its WPS button was
# pressed. wpa_supplicant writes what it got into the configuration it was started with
# (update_config), which is the one "rejoin" uses; it is in memory only, like every password here.
join_wps() {
    radio_down
    set_mac
    rm -f $STATIC
    state joining "WPS" "" chosen
    printf 'ctrl_interface=%s\nupdate_config=1\n' "$CTRL" > $RUN/nocry-sta.conf; chmod 600 $RUN/nocry-sta.conf
    rm -f $RUN/nocry-wpa.log
    wpa_supplicant -B -i $IF -D nl80211 -c $RUN/nocry-sta.conf -d -f $RUN/nocry-wpa.log >/dev/null 2>&1 || { log "wpa_supplicant did not start"; return 1; }
    sleep 1
    case "$(wpa_cli -p $CTRL -i $IF wps_pbc 2>&1)" in
      OK*) ;;
      *) WHY="this rescue image has no WPS support"; log "WPS: wps_pbc refused"; return 1 ;;
    esac
    log "WPS: waiting for a router with its button pressed"
    i=0; s=
    while [ $i -lt 120 ]; do
        if [ -e $RUN/nocry-wps.stop ]; then
            wpa_cli -p $CTRL -i $IF wps_cancel >/dev/null 2>&1
            WHY="cancelled"; CANCELLED=1; log "WPS: cancelled"; return 1
        fi
        s=$(wpa_cli -p $CTRL -i $IF status 2>/dev/null | sed -n 's/^wpa_state=//p')
        [ "$s" = COMPLETED ] && break
        grep -q "WPS-OVERLAP-DETECTED" $RUN/nocry-wpa.log 2>/dev/null && { WHY="more than one router is offering WPS right now; wait two minutes and try again"; log "WPS: overlap"; return 1; }
        grep -q "WPS-TIMEOUT" $RUN/nocry-wpa.log 2>/dev/null && break
        sleep 1; i=$((i+1))
    done
    if [ "$s" != COMPLETED ]; then
        if grep -q "WPS-FAIL" $RUN/nocry-wpa.log 2>/dev/null; then WHY="the router refused WPS (it may be turned off there, or the network is WPA3 only)"
        else WHY="no router offered WPS within two minutes (press the router's WPS button first; 2.4 GHz only)"; fi
        log "WPS failed: $WHY"
        return 1
    fi
    wpa_cli -p $CTRL -i $IF save_config >/dev/null 2>&1
    got_network "WPS" chosen
}

hex() { printf '%s' "$1" | hexdump -v -e '/1 "%02x"'; }

# The installed firmware's saved networks, as a wpa_supplicant configuration on stdout.
# Creality's firmware: /usr/data/wpa_supplicant.conf; NebulaOS: /usr/data/nebulaos/network/.
saved_conf() {
    p=$(part userdata) || return 1
    mkdir -p $RUN/nocry-data
    mount -t ext4 -o ro,noload "$p" $RUN/nocry-data 2>/dev/null || return 1
    found=
    for f in nebulaos/network/wpa_supplicant.conf nebulaos/wpa_supplicant.conf wpa_supplicant.conf; do
        g=$RUN/nocry-data/$f
        if [ -f "$g" ] && grep -q 'ssid=' "$g"; then found=$f; break; fi
    done
    if [ -n "$found" ]; then
        echo "ctrl_interface=$CTRL"
        # only the network blocks: the rest (update_config, country, control socket) is the firmware's business
        awk '/^[ \t]*network=\{/ { on = 1 } on { print } on && /^[ \t]*\}/ { on = 0 }' "$g"
    fi
    umount $RUN/nocry-data 2>/dev/null
    [ -n "$found" ] && echo "$found" > $RUN/nocry-wifi.saved-from
    [ -n "$found" ]
}

names() { sed -n 's/^[ \t]*ssid="\(.*\)"[ \t]*$/\1/p' "$1" | tr '\n' ',' | sed 's/,$//'; }

locked() {  # one change at a time; a second caller waits for the first
    i=0; while ! mkdir $LOCK 2>/dev/null && [ $i -lt 90 ]; do sleep 1; i=$((i+1)); done
    trap 'rmdir $LOCK 2>/dev/null' EXIT
}

mkdir -p $RUN $CTRL
case "$1" in
  auto)
    locked
    i=0; while [ ! -e /sys/class/net/$IF ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i+1)); done
    [ -e /sys/class/net/$IF ] || { state none "" "" ""; log "no Wi-Fi found"; exit 1; }
    set_mac; do_scan >/dev/null
    rm -f $STATIC
    if saved_conf > $RUN/nocry-sta.conf 2>/dev/null; then
        n=$(names $RUN/nocry-sta.conf)
        log "the installed firmware has a saved network ($n); joining it"
        join_conf $RUN/nocry-sta.conf "$n" saved && exit 0
    fi
    rm -f $RUN/nocry-sta.conf
    start_ap fallback ;;
  ap)
    locked; rm -f $RUN/nocry-sta.conf $STATIC; start_ap chosen ;;
  wps)
    locked
    rm -f $RUN/nocry-wps.stop
    if join_wps; then exit 0; fi
    rm -f $RUN/nocry-sta.conf $RUN/nocry-wps.stop
    start_ap "failed:WPS"
    echo "${WHY:-WPS did not complete}" >&2       # last: it is the line the screen shows
    [ -n "$CANCELLED" ] && exit 3
    exit 1 ;;
  wps-cancel) : > $RUN/nocry-wps.stop ;;        # no lock: the one waiting holds it
  off)
    locked; rm -f $RUN/nocry-sta.conf $STATIC
    was=$(sed -n 's/^ssid=//p' $STATE 2>/dev/null)
    radio_down; killall -q mdnsd 2>/dev/null
    state off "" "" chosen
    log "Wi-Fi off (was: $was)" ;;
  join)
    [ -n "$2" ] || { echo "usage: nocry-wifi join SSID [PASSWORD [static ADDRESS MASK [GATEWAY [DNS]]]]" >&2; exit 2; }
    if [ -n "$4" ]; then
        [ "$4" = static ] || { echo "usage: nocry-wifi join SSID PASSWORD static ADDRESS MASK [GATEWAY [DNS]]" >&2; exit 2; }
        quad "$5" || { echo "the IP address must be four numbers from 0 to 255, like 192.168.1.50" >&2; exit 2; }
        quad "$6" && [ -n "$(prefix "$6")" ] || { echo "the subnet mask is not valid (for example 255.255.255.0)" >&2; exit 2; }
        [ -z "$7" ] || quad "$7" || { echo "the gateway must be four numbers from 0 to 255, or empty" >&2; exit 2; }
        [ -z "$8" ] || quad "$8" || { echo "the DNS server must be four numbers from 0 to 255, or empty" >&2; exit 2; }
    fi
    n=${#3}
    if [ $n -ne 0 ] && { [ $n -lt 8 ] || [ $n -gt 63 ]; }; then echo "a Wi-Fi password has 8 to 63 characters" >&2; exit 2; fi
    case "$3" in *'"'*) echo "a password with a double quote is not supported here" >&2; exit 2 ;; esac
    locked
    # Phones like to turn ' into a curly apostrophe and " into curly quotes while typing; such a
    # password is longer in bytes than it looks and does not match. Counted, never stored.
    odd=$(printf '%s' "$3" | tr -d '\040-\176' | wc -c)
    bytes=$(printf '%s' "$3" | wc -c)
    [ "$odd" -gt 0 ] && HINT="nonascii:$odd"
    log "join requested: name of ${#2} characters, password of $bytes bytes, $odd of them outside plain ASCII"
    {
        echo "ctrl_interface=$CTRL"
        echo "network={"
        echo "    ssid=$(hex "$2")"         # as hex: any character in a name is safe
        echo "    scan_ssid=1"
        if [ $n -eq 0 ]; then echo "    key_mgmt=NONE"; else echo "    key_mgmt=WPA-PSK"; printf '    psk="%s"\n' "$3"; fi
        echo "}"
    } > $RUN/nocry-sta.conf
    chmod 600 $RUN/nocry-sta.conf
    if [ -n "$4" ]; then printf '%s\n%s\n%s\n%s\n' "$5" "$6" "$7" "$8" > $STATIC; else rm -f $STATIC; fi
    if join_conf $RUN/nocry-sta.conf "$2" chosen; then exit 0; fi
    rm -f $RUN/nocry-sta.conf $STATIC
    start_ap "failed:$2"
    exit 1 ;;
  rejoin)     # the network chosen or found last, again (after the radio was restarted)
    [ -s $RUN/nocry-sta.conf ] || { echo "no network was joined before" >&2; exit 2; }
    locked
    join_conf $RUN/nocry-sta.conf "$(sed -n 's/^ssid=//p' $STATE)" "$(sed -n 's/^source=//p' $STATE)" && exit 0
    start_ap "failed:rejoin"; exit 1 ;;
  scan) do_scan ;;
  status) cat $STATE 2>/dev/null || echo "mode=none" ;;
  saved)
    if saved_conf > $RUN/nocry-saved.tmp 2>/dev/null; then
        echo "from=$(cat $RUN/nocry-wifi.saved-from)"; echo "names=$(names $RUN/nocry-saved.tmp)"
    else echo "from="; fi
    rm -f $RUN/nocry-saved.tmp ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
