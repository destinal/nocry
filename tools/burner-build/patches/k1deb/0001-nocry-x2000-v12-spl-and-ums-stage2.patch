@@ -28,6 +28,10 @@
 #include <asm/arch/cpm.h>
 #include <asm/arch/mmc.h>
 #include <asm/jz_uart.h>
+#ifdef CONFIG_CMD_USB_MASS_STORAGE
+#include <mmc.h>
