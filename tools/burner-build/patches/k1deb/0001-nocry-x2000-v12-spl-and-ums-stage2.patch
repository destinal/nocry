+/*
+ * nocry: RAM-loaded stage2 exporting eMMC (MSC0 user area) as USB mass storage.
+ * MSC0 runs at the V12 burner clock (52 MHz, jz_sdhci.c) with SDMA (burner_x2000_v12.h).
