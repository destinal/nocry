+#endif
 
 DECLARE_GLOBAL_DATA_PTR;
 struct global_info ginfo __attribute__ ((section(".data")));
@@ -68,6 +72,76 @@
 
 int checkboard(void)
 {
+#ifdef CONFIG_NOCRY_UMS
+#ifdef CONFIG_NOCRY_UMS_RO
+	puts("Board: nocry-ums-ro (Ingenic XBurst2 X2000-V12)\n");
+#else
+	puts("Board: nocry-ums (Ingenic XBurst2 X2000-V12)\n");
+#endif
+#endif
+	return 0;
+}
+
+#ifdef CONFIG_CMD_USB_MASS_STORAGE
+/* nocry: expose the whole MSC0 user area as one LUN. */
+static int ums_read_sector(struct ums_device *ums_dev,
+			   ulong start, lbaint_t blkcnt, void *buf)
+{
+	if (ums_dev->mmc->block_dev.block_read(ums_dev->dev_num,
+			start + ums_dev->offset, blkcnt, buf) != blkcnt)
+		return -1;
 	return 0;
 }
 
+static int ums_write_sector(struct ums_device *ums_dev,
+			    ulong start, lbaint_t blkcnt, const void *buf)
+{
+#ifdef CONFIG_NOCRY_UMS_RO
+	return -1;	/* belt and braces: LUN is also reported write-protected */
+#else
+	if (ums_dev->mmc->block_dev.block_write(ums_dev->dev_num,
+			start + ums_dev->offset, blkcnt, buf) != blkcnt)
+		return -1;
+	return 0;
+#endif
+}
+
+static void ums_get_capacity(struct ums_device *ums_dev,
+			     long long int *capacity)
+{
+	long long int tmp = (long long int)(ums_dev->offset + ums_dev->part_size)
+				* SECTOR_SIZE;
+	*capacity = ums_dev->mmc->capacity - tmp;
+}
+
+static struct ums_board_info ums_board = {
+	.read_sector	= ums_read_sector,
+	.write_sector	= ums_write_sector,
+	.get_capacity	= ums_get_capacity,
+	.name		= "nocry eMMC",
+};
+
+struct ums_board_info *board_ums_init(unsigned int dev_num, unsigned int offset,
+				      unsigned int part_size)
+{
+	struct mmc *mmc = find_mmc_device(dev_num);
+
+	if (!mmc || mmc_init(mmc))
+		return NULL;
+
+	printf("ums: mmc%u capacity %llu bytes, %u-bit bus, %u Hz%s\n", dev_num,
+	       mmc->capacity, mmc->bus_width, mmc->clock,
+#ifdef CONFIG_NOCRY_UMS_RO
+	       " (read-only)"
+#else
+	       ""
+#endif
+	       );
+	ums_board.ums_dev.mmc = mmc;
+	ums_board.ums_dev.dev_num = dev_num;
+	ums_board.ums_dev.offset = offset;
+	ums_board.ums_dev.part_size = part_size;
+	return &ums_board;
+}
+#endif /* CONFIG_CMD_USB_MASS_STORAGE */
+
