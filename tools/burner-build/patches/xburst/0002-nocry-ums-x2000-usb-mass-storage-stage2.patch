 int board_early_init_f(void)
 {
@@ -86,6 +92,14 @@
 /* U-Boot common routines */
 int checkboard(void)
 {
+#ifdef CONFIG_NOCRY_UMS
+#ifdef CONFIG_NOCRY_UMS_RO
+	puts("Board: nocry-ums-ro (Ingenic XBurst2 X2000 SoC)\n");
+#else
+	puts("Board: nocry-ums (Ingenic XBurst2 X2000 SoC)\n");
