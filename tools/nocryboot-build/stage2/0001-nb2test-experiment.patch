diff --git a/common/cmd_nb2test.c b/common/cmd_nb2test.c
new file mode 100644
index 000000000..b77460803
--- /dev/null
+++ b/common/cmd_nb2test.c
@@ -0,0 +1,89 @@
+/*
+ * nb2test: what a nocryboot second stage would need to see on this board, tried once and
+ * printed (read back with `nocry boot-log`). Nothing is written anywhere.
+ * SPDX-License-Identifier: GPL-2.0+
+ *
+ *   touch   the NS2009 on the I2C4 pins (PC25/PC26), bit-banged: is the screen pressed?
+ *   usb     host mode on the OTG controller with the two port supplies on: what is attached,
+ *           how long that takes, and whether a FAT file "nocry-rescue.txt" can be read
+ *   ext4    whether the data partition's file system can be listed from here
+ */
+#include <common.h>
+#include <command.h>
+#include <usb.h>
+#include <asm/gpio.h>
+#include <asm/arch/gpio.h>
+
+static int sda, scl;
+static void dly(void) { udelay(5); }
+static void sda_hi(void) { gpio_direction_input(sda); }
+static void sda_lo(void) { gpio_direction_output(sda, 0); }
+static void scl_hi(void) { gpio_direction_input(scl); dly(); }
+static void scl_lo(void) { gpio_direction_output(scl, 0); dly(); }
+static void i2c_start(void) { sda_hi(); scl_hi(); sda_lo(); dly(); scl_lo(); }
+static void i2c_stop(void) { sda_lo(); scl_hi(); sda_hi(); dly(); }
+static int i2c_wr(unsigned char b)	/* 0 = acknowledged */
+{
+	int i, nak;
+	for (i = 7; i >= 0; i--) { if (b & (1 << i)) sda_hi(); else sda_lo(); scl_hi(); scl_lo(); }
+	sda_hi(); scl_hi(); nak = gpio_get_value(sda); scl_lo();
+	return nak;
+}
+static unsigned char i2c_rd(int ack)
+{
+	int i; unsigned char b = 0;
+	sda_hi();
+	for (i = 7; i >= 0; i--) { scl_hi(); if (gpio_get_value(sda)) b |= 1 << i; scl_lo(); }
+	if (ack) sda_lo(); else sda_hi();
+	scl_hi(); scl_lo(); sda_hi();
+	return b;
+}
+/* one NS2009 measurement (12 bits); -1 if the chip does not answer */
+static int ns2009(unsigned char cmd)
+{
+	unsigned char a, b;
+	i2c_start();
+	if (i2c_wr(0x48 << 1) || i2c_wr(cmd)) { i2c_stop(); return -1; }
+	i2c_stop();
+	udelay(200);
+	i2c_start();
+	if (i2c_wr((0x48 << 1) | 1)) { i2c_stop(); return -1; }
+	a = i2c_rd(1); b = i2c_rd(0);
+	i2c_stop();
+	return (a << 4) | (b >> 4);
+}
+
+static int do_nb2test(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
+	int i, n = argc > 1 ? simple_strtoul(argv[1], NULL, 10) : 20;
+	ulong t0;
+
+	sda = GPIO_PC(25); scl = GPIO_PC(26);
+	if (ns2009(0xc0) < 0) { sda = GPIO_PC(26); scl = GPIO_PC(25); }
+	printf("nb2: touch chip %s (data on PC%d)\n", ns2009(0xc0) < 0 ? "does not answer" : "answers", sda - GPIO_PC(0));
+	for (i = 0; i < n; i++) {
+		printf("nb2: touch %2d  x=%4d y=%4d z1=%4d z2=%4d\n", i, ns2009(0xc0), ns2009(0xd0), ns2009(0xe0), ns2009(0xf0));
+		mdelay(500);
+	}
+
+	t0 = get_timer(0);
+	i = usb_init();
+	printf("nb2: usb_init %d after %lu ms\n", i, get_timer(t0));
+	if (i >= 0) {
+		i = usb_stor_scan(1);
+		printf("nb2: usb storage scan %d after %lu ms\n", i, get_timer(t0));
+		run_command("usb tree", 0);
+		if (i >= 0) {
+			i = run_command("fatload usb 0:1 0x88000000 nocry-rescue.txt 0x1000", 0);
+			if (i) i = run_command("fatload usb 0 0x88000000 nocry-rescue.txt 0x1000", 0);
+			printf("nb2: marker file %s after %lu ms\n", i ? "not found" : "found", get_timer(t0));
+		}
+		usb_stop();
+	}
+	t0 = get_timer(0);
+	i = run_command("ext4ls mmc 0:a /", 0);
+	printf("nb2: ext4 listing %s after %lu ms\n", i ? "failed" : "worked", get_timer(t0));
+	return 0;
+}
+
+U_BOOT_CMD(nb2test, 2, 0, do_nb2test, "try what nocryboot's second stage needs", "[touch samples]");
