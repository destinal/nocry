diff --git a/board/ingenic/x2000_base/nocryboot/partitions.tab b/board/ingenic/x2000_base/nocryboot/partitions.tab
new file mode 100644
index 000000000..21897ec62
--- /dev/null
+++ b/board/ingenic/x2000_base/nocryboot/partitions.tab
@@ -0,0 +1,21 @@
+# nocryboot: the start of the eMMC as Creality's X2000E boards lay it out.
+# Only the partitions the SPL reads are listed; they sit at the same place on
+# the Nebula Pad family and on the K1 family (what follows differs per board
+# and per storage size, and the SPL never looks at it).
+property:
+    disk_size = 60m
+    gpt_header_lba = 512
+    custom_signature = 0
+
+partition:
+	#name     =  start,   size, fstype
+	xboot     =     0m,     1m,
+	ota       =     1m,     1m, EMPTY
+	sn_mac    =     2m,     1m, EMPTY
+	rtos      =     3m,     4m, EMPTY
+	rtos2     =     7m,     4m, EMPTY
+	kernel    =    11m,     8m, EMPTY
+	kernel2   =    19m,     8m, EMPTY
+	rest      =    27m,    33m, LINUX_FS
+
+#fstype could be: LINUX_FS, FAT_FS, EMPTY
