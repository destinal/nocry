diff --git a/common/spl/spl_auto_args_mem.c b/common/spl/spl_auto_args_mem.c
index 6f64c2880..0fbf94acf 100644
--- a/common/spl/spl_auto_args_mem.c
+++ b/common/spl/spl_auto_args_mem.c
@@ -135,6 +135,14 @@ static char* process_mem_bootargs(char *cmdargs, int ram_size)
 	args_mem = add_mem(args_mem, "share_mem=", ram_size, share_mem_size, kb_flags);
 	ram_size += share_mem_size;
 
+#ifdef CONFIG_SPL_ARGS_MEM_ALWAYS_HIGH
+	if (real_size >= 256) {
+		real_size = real_size - 256;
+		args_mem += string_copy(args_mem, " mem=", 5);
+		args_mem += int_to_string(args_mem, real_size, 10);
+		args_mem += string_copy(args_mem, "M@0x30000000", 12);
+	} else
+#endif
 	if (real_size > 256) {
 		real_size = real_size - 256;
 		real_size = kb_flags ? real_size * 1024 : real_size;
@@ -191,3 +199,24 @@ char* spl_board_process_mem_bootargs(char *cmdargs)
 
 	return process_mem_bootargs(cmdargs, ram_size);
 }
+
+#ifdef CONFIG_SPL_RTOS_LCM_ID
+extern unsigned int spl_rtos_lcm_id;
+
+/* Replace "[lcm-start...lcm-end]" in the kernel arguments by "lcm_id=<n>". */
+char *spl_process_lcm_bootargs(char *cmdargs)
+{
+	char *start = strstr(cmdargs, "[lcm-start");
+	char *end = strstr(cmdargs, "lcm-end]");
+
+	if (!start || !end)
+		return cmdargs;
+	end += strlen("lcm-end]");
+
+	start += string_copy(start, "lcm_id=", 7);
+	start += int_to_string(start, spl_rtos_lcm_id, 10);
+	memmove(start, end, strlen(end) + 1);
+
+	return cmdargs;
+}
+#endif
diff --git a/common/spl/spl_jzsdhci.c b/common/spl/spl_jzsdhci.c
index 94d5f08d4..4cc8e789a 100644
--- a/common/spl/spl_jzsdhci.c
+++ b/common/spl/spl_jzsdhci.c
@@ -1670,10 +1670,25 @@ static stop_second_cpu(void)
 	local_irq_restore(flags);
 }
 
+#ifdef CONFIG_SPL_RTOS_LCM_ID
+/*
+ * Panel id reported by the rtos image.  The image receives the size of the
+ * mapped partition in the word that rtos_header.mapped_rtosdata_size points
+ * to, and overwrites that word with the id of the panel it found before it
+ * signals that it is done.  An unchanged word means "no id".
+ */
+unsigned int spl_rtos_lcm_id;
+#endif
+
 static void start_second_cpu(void)
 {
 	unsigned long value;
 	volatile unsigned long *rtos_start = (unsigned long *)rtos_header.img_start;
+#ifdef CONFIG_SPL_RTOS_LCM_ID
+	volatile unsigned int *lcm = (unsigned int *)rtos_header.mapped_rtosdata_size;
+
+	spl_rtos_lcm_id = *lcm;
+#endif
 
 	value = *rtos_start;
 
@@ -1685,6 +1700,9 @@ static void start_second_cpu(void)
 			mdelay(1);
 		}
 
+#ifdef CONFIG_SPL_RTOS_LCM_ID
+		spl_rtos_lcm_id = (*lcm == spl_rtos_lcm_id) ? 0 : *lcm;
+#endif
 		stop_second_cpu();
 	}
 }
