diff --git a/include/configs/nocryboot.h b/include/configs/nocryboot.h
new file mode 100644
index 000000000..2a4c925ef
--- /dev/null
+++ b/include/configs/nocryboot.h
@@ -0,0 +1,84 @@
+/*
+ * nocryboot: open boot loader for Creality's Ingenic X2000E boards
+ * (Nebula Pad family and K1 family).  SPDX-License-Identifier: GPL-2.0+
+ *
+ * This is the first stage (SPL) that the SoC's boot ROM loads from the eMMC.
+ * It does what the factory SPL does:
+ *   1. read the "ota" record to choose slot A or B,
+ *   2. load the rtos image of that slot and run it on CPU core 1 (boot picture),
+ *      with the whole "sn_mac" partition placed at the top of its heap,
+ *   3. load the kernel of that slot and start Linux, passing the panel id that
+ *      the rtos image reported (lcm_id=<n>).
+ *
+ * Select the board family with NOCRYBOOT_NEBULA or NOCRYBOOT_K1 in boards.cfg.
+ */
+#ifndef __NOCRYBOOT_H__
+#define __NOCRYBOOT_H__
+
+#define CONFIG_NOCRYBOOT
+
+#define CONFIG_ROOTFS_SQUASHFS
+#define CONFIG_ROOTFS2_SQUASHFS
+#define CONFIG_SPL_SERIAL_SUPPORT
+
+/* Not applied on x2000_v12 (the call is disabled in soc.c); the GPIO driver
+ * still wants them defined. */
+#define CONFIG_VDD_CIM_VOLTAGE	GPIO_VOLTAGE_3V3
+#define CONFIG_VDD_SD_VOLTAGE	GPIO_VOLTAGE_3V3
+
+/* Debug UART = Linux console: UART4 on the Nebula Pad, UART2 on K1 boards. */
+#if defined(CONFIG_NOCRYBOOT_NEBULA)
+#define CONFIG_SYS_UART_INDEX		4
+#define CONFIG_SYS_UART4_PA		/* on pins PA2/PA3 */
+#elif defined(CONFIG_NOCRYBOOT_K1)
+#define CONFIG_SYS_UART_INDEX		2
+#else
+#error "nocryboot: choose NOCRYBOOT_NEBULA or NOCRYBOOT_K1"
+#endif
+
+#define CONFIG_BAUDRATE			115200
+
+/* Slot A = rtos/kernel/rootfs (partition 7), slot B = rtos2/kernel2/rootfs2 (8). */
+#define CONFIG_ROOTFS_DEV		"root=/dev/mmcblk0p7 rootwait"
+#define CONFIG_ROOTFS2_DEV		"root=/dev/mmcblk0p8 rootwait"
+#define CONFIG_SPL_RTOS_NAME2		"rtos2"
+
+/* Replaced at run time by "lcm_id=<n>", the panel the rtos image found. */
+#define CONFIG_SPL_RTOS_LCM_ID
+#define CONFIG_ARGS_EXTRA		"[lcm-start-----------------lcm-end]"
+
+/* Partitions the SPL needs; identical on both board families. */
+#define CONFIG_GPT_TABLE_PATH		"$(TOPDIR)/board/ingenic/x2000_base/nocryboot"
+
+#include "x2000_base_common.h"
+
+/*
+ * These boards all carry an X2000E, whose built-in memory is the W97BV6MK
+ * LPDDR2.  With a single memory type the SPL uses it directly and never has
+ * to read the SoC id from the eFuse block; nocryboot does not touch eFuse.
+ */
+#define CONFIG_SPL_NO_EFUSE
+#undef  CONFIG_DDR_TYPE_LPDDR3
+#undef  CONFIG_LPDDR3_W63AH6NKB_BI
+#undef  CONFIG_LPDDR3_NK6CL256M16DKX_H1
+
+/*
+ * Where the current Ingenic code differs from the SPL Creality ships, keep
+ * what these boards have always run with:
+ *  - no on-die termination request (LPDDR2 has none),
+ *  - "active power-down" for idle memory,
+ *  - the plain PHY reset sequence,
+ *  - pull-downs of the boot pins left as the boot ROM set them,
+ *  - the second memory bank named in the kernel arguments even when empty.
+ */
+#undef  CONFIG_DDR_CHIP_ODT
+#define CONFIG_DDRC_ACTIVE_POWER_DOWN
+#define CONFIG_DDRC_PHY_RESET_PLAIN
+#define CONFIG_GPIO_KEEP_PULLDOWN
+#define CONFIG_SPL_ARGS_MEM_ALWAYS_HIGH
+
+/* The rtos image gets the device identity instead of an "rtosdata" file system. */
+#undef  CONFIG_SPL_RTOS_LINUX_MAPPED_FILESYSTEM_NAME
+#define CONFIG_SPL_RTOS_LINUX_MAPPED_FILESYSTEM_NAME	"sn_mac"
+
+#endif /* __NOCRYBOOT_H__ */
