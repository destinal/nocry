nocryboot: start the rescue system when the screen is held, or when no slot can start

The Nebula Pad build reads the touch chip once at start (NS2009, I2C bit-banged on PC25/PC26).
If the screen is pressed it looks for the rescue system, a Linux kernel as a uImage, in the
last 50 MiB of each root file system partition (the slot that would start first, then the
other), checks the header and the contents against the CRCs in the header, and starts it with
nocry.rescue=touch. Anything missing or wrong and the board starts as always. The same is
tried when neither slot can be started, before the board goes to USB boot mode. Version 0.5
(0.4: only when the screen is held; 0.3, never released, had the copies in the last 32 MiB;
0.2 read a file on the data partition through a note in "ota").
---
diff --git a/common/spl/spl_jzsdhci.c b/common/spl/spl_jzsdhci.c
index 6e6d88620..3e6871473 100644
--- a/common/spl/spl_jzsdhci.c
+++ b/common/spl/spl_jzsdhci.c
@@ -2065,6 +2065,7 @@ void spl_mmc_mcu_rtos_boot(void)
 #ifdef CONFIG_NOCRYBOOT
 extern void nocryboot_usb_boot_mode(const char *why);
 extern int nocryboot_console_asks(void);
+extern int nocryboot_touch_held(void);
 extern const char nocryboot_ident[];
 
 /*
@@ -2216,6 +2217,78 @@ static int nocryboot_slot_state(int slot_b)
  *     nocryboot:incomplete=B    parts missing, left it
  *     nocryboot:unconfirmed=B   never reported success, but nothing else to start
  */
+#ifdef CONFIG_NOCRYBOOT_TOUCH
+/*
+ * The rescue system: a Linux kernel with its files built in.  It is kept where nothing else
+ * writes: in the last 50 MiB of each of the two root file system partitions, far behind the
+ * end of any system image, so that an update of the firmware, a factory reset and a damaged
+ * data partition all leave it alone.  Each copy is a plain uImage named "nocry-rescue...",
+ * a kernel that needs no unpacking by the loader.  A copy is started only if the checksums
+ * of its header and of its contents are right; the copy in the slot that would start is
+ * tried first, then the other.  If neither is good this returns and the board starts as
+ * always.  It is started when the screen is held at power-on, and by itself when no slot
+ * can be started (before the board gives up and goes to USB boot mode).
+ */
+#define NB_SCRATCH	0x8f000000	/* far above anything loaded */
+#define NB_RESCUE_ROOM	(50 << 11)	/* sectors: 50 MiB */
+
+static u32 nb_crc(const u32 *table, const u8 *p, u32 len)
+{
+	u32 c = ~0;
+
+	while (len--)
+		c = table[(c ^ *p++) & 0xff] ^ (c >> 8);
+	return ~c;
+}
+
+static void nocryboot_rescue_at(const char *name)
+{
+	struct image_header *ih = (struct image_header *)NB_SCRATCH;
+	u32 *table = (u32 *)(NB_SCRATCH + 512), *dst;
+	unsigned int sector, size, count, n;
+	u32 len, c, hcrc;
+	int i, k;
+
+	if (spl_get_built_in_gpt_partition(name, &sector, &size) || size < NB_RESCUE_ROOM)
+		return;
+	sector += size - NB_RESCUE_ROOM;
+	if (mmc_block_read(sector, 1, (u32 *)ih) < 0 ||
+	    image_get_magic(ih) != IH_MAGIC || strncmp((char *)ih->ih_name, "nocry-rescue", 12))
+		return;
+	for (i = 0; i < 256; i++) {
+		for (c = i, k = 0; k < 8; k++)
+			c = c & 1 ? c >> 1 ^ 0xedb88320 : c >> 1;
+		table[i] = c;
+	}
+	hcrc = image_get_hcrc(ih);
+	ih->ih_hcrc = 0;
+	len = image_get_size(ih);
+	dst = (u32 *)(image_get_load(ih) - sizeof(*ih));
+	count = (len + sizeof(*ih) + 511) / 512;
+	if (nb_crc(table, (u8 *)ih, sizeof(*ih)) != hcrc || count > NB_RESCUE_ROOM ||
+	    (u32)dst < 0x80100000 || (u32)dst > 0x86000000)
+		return;
+	spl_image.entry_point = image_get_ep(ih);
+	c = image_get_dcrc(ih);
+	for (ih = (struct image_header *)dst; count; count -= n, sector += n, dst += n * 128) {
+		n = count > 0x8000 ? 0x8000 : count;
+		if (mmc_block_read(sector, n, dst) < 0)
+			return;
+	}
+	if (nb_crc(table, (u8 *)(ih + 1), len) != c)
+		return;
+	puts("nocryboot: rescue\n");
+	jump_to_image_linux("nocry.rescue=touch");
+}
+
+/* the copy in the slot that would start first, then the other; returns if neither is good */
+static void nocryboot_rescue(int slot)
+{
+	nocryboot_rescue_at(slot ? "rootfs2" : "rootfs");
+	nocryboot_rescue_at(slot ? "rootfs" : "rootfs2");
+}
+#endif
+
 static char *nocryboot_load(void)
 {
 	char *buf = (char *)CONFIG_SYS_TEXT_BASE;
@@ -2234,6 +2307,13 @@ static char *nocryboot_load(void)
 	if (nocryboot_read_head(CONFIG_SPL_OTA_NAME, (u32 *)buf) &&
 	    !strncmp("ota:"CONFIG_SPL_OS_NAME2, buf, strlen("ota:"CONFIG_SPL_OS_NAME2)))
 		slot = 1;
+#ifdef CONFIG_NOCRYBOOT_TOUCH
+	/* the screen held at power-on asks for the rescue system */
+	if (nocryboot_touch_held()) {
+		nocryboot_rescue(slot);
+		puts("nocryboot: screen held, but no rescue system\n");
+	}
+#endif
 
 	spl_get_built_in_gpt_partition(CONFIG_SPL_OTA_NAME, &ota, NULL);
 	memset(buf, 0, 512);
@@ -2250,6 +2330,10 @@ static char *nocryboot_load(void)
 			slot = !slot;
 			nocryboot_note(ota, "ota:", slot ? CONFIG_SPL_OS_NAME2 : CONFIG_SPL_OS_NAME, "\n\n");
 		} else if (!ok) {
+#ifdef CONFIG_NOCRYBOOT_TOUCH
+			/* nothing to start: the rescue system, if the board has one, before the door */
+			nocryboot_rescue(slot);
+#endif
 			nocryboot_usb_boot_mode("no slot can be started");
 		} else {
 			nocryboot_note(ota + 1, "nocryboot:unconfirmed=", slot ? "B" : "A", "\n");
diff --git a/common/spl/spl_nocryboot.c b/common/spl/spl_nocryboot.c
index bc17057ed..9f0476129 100644
--- a/common/spl/spl_nocryboot.c
+++ b/common/spl/spl_nocryboot.c
@@ -38,6 +38,64 @@ void nocryboot_usb_boot_mode(const char *why)
 		;
 }
 
+#ifdef CONFIG_NOCRYBOOT_TOUCH
+/*
+ * Is the screen being pressed?  One pressure reading of the NS2009 touch chip, the I2C
+ * bus bit-banged on the two pins as open-drain lines (driven low or released to the
+ * pull-ups).  Not pressed reads 0, a finger about 2200 of 4095; a chip that does not answer
+ * counts as not pressed.  Three readings 20 ms apart must agree, so noise cannot open it.
+ */
+#define GPC		0xb0010200
+#define T_SCL		(1 << 25)
+#define T_SDA		(1 << 26)
+static void t_pin(u32 pin, int high)	/* PAT1 set = input (released), clear = output low */
+{
+	writel(pin, GPC + (high ? 0x34 : 0x38));
+	udelay(5);
+}
+static u32 t_xfer(u32 out)		/* nine bits out (1 = released), nine bits back */
+{
+	u32 in = 0;
+	int i;
+
+	for (i = 8; i >= 0; i--) {
+		t_pin(T_SDA, (out >> i) & 1);
+		t_pin(T_SCL, 1);
+		in = in << 1 | ((readl(GPC) >> 26) & 1);
+		t_pin(T_SCL, 0);
+	}
+	return in;
+}
+static void t_start(void) { t_pin(T_SDA, 1); t_pin(T_SCL, 1); t_pin(T_SDA, 0); t_pin(T_SCL, 0); }
+static void t_stop(void) { t_pin(T_SDA, 0); t_pin(T_SCL, 1); t_pin(T_SDA, 1); }
+
+int nocryboot_touch_held(void)
+{
+	u32 a, b, nak;
+	int n;
+
+	writel(T_SCL | T_SDA, GPC + 0x18);	/* not interrupts */
+	writel(T_SCL | T_SDA, GPC + 0x24);	/* plain GPIO */
+	writel(T_SCL | T_SDA, GPC + 0x48);	/* when driven: low */
+	for (n = 0; n < 3; n++) {
+		t_start();
+		nak = t_xfer(0x90 << 1 | 1) & 1;		/* address 0x48, write */
+		nak |= t_xfer(0xe0 << 1 | 1) & 1;		/* measure pressure (Z1) */
+		t_stop();
+		udelay(200);
+		t_start();
+		nak |= t_xfer(0x91 << 1 | 1) & 1;		/* address 0x48, read */
+		a = t_xfer(0xff << 1) >> 1;			/* acknowledged */
+		b = t_xfer(0x1ff) >> 1;				/* last byte */
+		t_stop();
+		if (nak || (a << 4 | b >> 4) < 600)
+			return 0;
+		udelay(20000);
+	}
+	return 1;
+}
+#endif
+
