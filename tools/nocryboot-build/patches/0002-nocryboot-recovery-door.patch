diff --git a/common/spl/spl_jzsdhci.c b/common/spl/spl_jzsdhci.c
index 4cc8e789a..2845d268b 100644
--- a/common/spl/spl_jzsdhci.c
+++ b/common/spl/spl_jzsdhci.c
@@ -2062,6 +2062,101 @@ void spl_mmc_mcu_rtos_boot(void)
 }
 #endif
 
+#ifdef CONFIG_NOCRYBOOT
+extern void nocryboot_usb_boot_mode(const char *why);
+extern int nocryboot_console_asks(void);
+
+#define NB_KERNEL	1
+#define NB_RTOS		2
+
+/* Read the first sector of a partition; 0 if there is no such partition or the read fails. */
+static int nocryboot_read_head(const char *name, u32 *buf)
+{
+	unsigned int sector;
+	u32 ret;
+
+	memset(buf, 0, 512);
+	if (spl_get_built_in_gpt_partition(name, &sector, NULL))
+		return 0;
+	ret = mmc_block_read(sector, 1, buf);
+	return ret != 0 && ret != (u32)-1;
+}
+
+/* What a slot holds: a kernel image that can be started, a boot picture image. */
+static int nocryboot_slot_state(int slot_b)
+{
+	u32 *buf = (u32 *)CONFIG_SYS_TEXT_BASE;
+	struct image_header *ih = (struct image_header *)buf;
+	struct rtos_header *rh = (struct rtos_header *)buf;
+	int state = 0;
+
+	if (nocryboot_read_head(slot_b ? CONFIG_SPL_OS_NAME2 : CONFIG_SPL_OS_NAME, buf) &&
+	    image_get_magic(ih) == IH_MAGIC && image_get_os(ih) == IH_OS_LINUX &&
+	    image_get_load(ih) >= 0x80000000 && image_get_load(ih) < 0x90000000 &&
+	    image_get_data_size(ih) > 0 && image_get_data_size(ih) < 64 * 1024 * 1024)
+		state |= NB_KERNEL;
+
+	if (nocryboot_read_head(slot_b ? CONFIG_SPL_RTOS_NAME2 : CONFIG_SPL_RTOS_NAME, buf) &&
+	    rh->tag == 0x534f5452 && rh->img_start < rh->img_end)
+		state |= NB_RTOS;
+
+	return state;
+}
+
+/*
+ * nocryboot's boot decision.  The factory loader takes the slot the "ota"
+ * record names and hangs if its boot picture image is missing or damaged.
+ * Here:
+ *   - the named slot is started if it has a kernel (without the boot picture
+ *     if that image is bad: the screen then stays dark until Linux is up);
+ *   - else the other slot, if that one has a kernel;
+ *   - else, or when asked at the serial console, USB boot mode.
+ */
+static char *nocryboot_load(void)
+{
+	u32 *buf = (u32 *)CONFIG_SYS_TEXT_BASE;
+	unsigned int sector;
+	int want_b = 0, slot, state;
+
+	if (nocryboot_console_asks())
+		nocryboot_usb_boot_mode("asked at the console");
+#ifdef CONFIG_NOCRYBOOT_DOOR_TEST
+	/* test build: checks that the boot ROM honours the request */
+	nocryboot_usb_boot_mode("door test");
+#endif
+
+	if (nocryboot_read_head(CONFIG_SPL_OTA_NAME, buf) &&
+	    !strncmp("ota:"CONFIG_SPL_OS_NAME2, (char *)buf, strlen("ota:"CONFIG_SPL_OS_NAME2)))
+		want_b = 1;
+
+	slot = want_b;
+	state = nocryboot_slot_state(slot);
+	if (!(state & NB_KERNEL)) {
+		printf("nocryboot: slot %s has no kernel\n", slot ? "B" : "A");
+		slot = !slot;
+		state = nocryboot_slot_state(slot);
+		if (!(state & NB_KERNEL))
+			nocryboot_usb_boot_mode("no slot has a kernel");
+	}
+
+	if (state & NB_RTOS) {
+		spl_get_built_in_gpt_partition(slot ? CONFIG_SPL_RTOS_NAME2 : CONFIG_SPL_RTOS_NAME, &sector, NULL);
+		if (!mmc_rtos_load(&rtos_header, sector)) {
+			flush_cache_all();
+			mmc_rtos_load_rtosdata_partition(&rtos_header);
+			start_second_cpu();
+		}
+	} else {
+		printf("nocryboot: slot %s has no boot picture image\n", slot ? "B" : "A");
+	}
+
+	spl_get_built_in_gpt_partition(slot ? CONFIG_SPL_OS_NAME2 : CONFIG_SPL_OS_NAME, &sector, NULL);
+	mmc_load_image_raw(sector, slot ? CONFIG_SPL_OS_NAME2 : CONFIG_SPL_OS_NAME);
+
+	return slot ? CONFIG_SYS_SPL_ARGS_ADDR2 : CONFIG_SYS_SPL_ARGS_ADDR;
+}
+#endif
