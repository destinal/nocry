diff --git a/common/spl/spl_nocryboot.c b/common/spl/spl_nocryboot.c
new file mode 100644
index 000000000..48ae715da
--- /dev/null
+++ b/common/spl/spl_nocryboot.c
@@ -0,0 +1,56 @@
+/*
+ * nocryboot: the recovery door.  SPDX-License-Identifier: GPL-2.0+
+ *
+ * The SoC's boot ROM can be asked to start in USB boot mode on the next reset,
+ * the same mode the BOOT button selects: a magic value in the CPM "SLPC"
+ * register, then a watchdog reset.  From USB boot mode a PC can always repair
+ * the board (nocry does), because that mode does not depend on the eMMC.
+ *
+ * The factory loader never uses this: it hangs when it finds nothing to start.
+ */
+#include <common.h>
+#include <asm/io.h>
+#include <asm/arch/cpm.h>
+#include <asm/arch/wdt.h>
+
+#define SLPC_SW_MAGIC		0x425753	/* "SWB": software boot select */
+#define SLPC_SW_USB_BOOT	0x2
+
+void nocryboot_usb_boot_mode(const char *why)
+{
+	int time = RTC_FREQ / WDT_DIV * RESET_DELAY_MS / 1000;
+
+	printf("nocryboot: %s; restarting in USB boot mode\n", why);
+
+	cpm_outl(SLPC_SW_MAGIC << 8 | SLPC_SW_USB_BOOT, CPM_SLPC);
+
+	/* watchdog reset, a few ms from now */
+	writel(TSCR_WDTSC, TCU_BASE + TCU_TSCR);
+	writel(0, WDT_BASE + WDT_TCNT);
+	writel(time, WDT_BASE + WDT_TDR);
+	writel(TCSR_PRESCALE | TCSR_RTC_EN | TCSR_CLRZ, WDT_BASE + WDT_TCSR);
+	writel(0, WDT_BASE + WDT_TCER);
+	writel(TCER_TCEN, WDT_BASE + WDT_TCER);
+
+	for (;;)
+		;
+}
+
+/*
+ * Someone at the serial console asking for the door: at least three ESC
+ * characters, and nothing else, received since the console came up.
+ */
+int nocryboot_console_asks(void)
+{
+	volatile u8 *uart = (volatile u8 *)(0xb0030000 + CONFIG_SYS_UART_INDEX * 0x1000);
+	int esc = 0, other = 0, n;
+
+	for (n = 0; n < 64 && (uart[0x14] & 1); n++) {	/* LSR: data ready */
+		if (uart[0] == 0x1b)
+			esc++;
+		else
+			other++;
+	}
+
+	return esc >= 3 && !other;
+}
