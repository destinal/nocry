;
; nocry: lets Windows' built-in WinUSB driver handle the board. No driver code is installed;
; this file only tells Windows which USB devices are the board.
;
[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %Provider%
CatalogFile = nocry.cat
DriverVer   = 11/26/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%Provider% = Devices,NTamd64,NTarm64

[Devices.NTamd64]
%Bootrom%  = USB_Install, USB\VID_A108&PID_EAEF
%Loader%   = USB_Install, USB\VID_1209&PID_0002
%RecAdb%   = USB_Install, USB\VID_1209&PID_0003&MI_02
%RecFb%    = USB_Install, USB\VID_1209&PID_0003&MI_03

[Devices.NTarm64]
%Bootrom%  = USB_Install, USB\VID_A108&PID_EAEF
%Loader%   = USB_Install, USB\VID_1209&PID_0002
%RecAdb%   = USB_Install, USB\VID_1209&PID_0003&MI_02
%RecFb%    = USB_Install, USB\VID_1209&PID_0003&MI_03

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg = Dev_AddReg

; the first GUID is the one Android's adb.exe and fastboot.exe look for
[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{F72FE0D4-CBCB-407D-8814-9ED673D0DD6B}","{6E0C5B6A-3F0B-4D53-9B5E-6E6F63727901}"

[Strings]
Provider = "nocry"
Bootrom  = "Ingenic X2000 board in USB boot mode (nocry)"
Loader   = "nocry loader (fastboot)"
RecAdb   = "nocry recovery (adb)"
RecFb    = "nocry recovery (fastboot)"
